---
import SiteLayout from '../layouts/SiteLayout.astro';
import { serializeJsonScript } from '../lib/json-script';
import { existsSync, readFileSync } from 'node:fs';
import path from 'node:path';

// Build-time static JSON loads
import copy from '../../docs/data/factory-copy.json';
import stats from '../../docs/data/factory-stats.json';
import telemetry from '../../docs/data/factory-telemetry.json';
import upstreamStatus from '../../docs/data/upstream-status.json';
import bstCache from '../../docs/data/bst-cache.json';
import testsMatrix from '../../docs/data/tests-matrix.json';
import releaseVerdict from '../../docs/data/release-verdict.json';
import fleetTelemetry from '../../docs/data/fleet-telemetry.json';
import usb4Execution from '../../docs/data/usb4-execution.json';

const baseUrl = import.meta.env.BASE_URL;

interface PublishBuildRun {
  recorded_at: string;
  plane: 'publish' | 'lab';
  repo: string;
  lane: string;
  run_id: string;
  status: 'passed' | 'failed' | 'running';
  started_at: string;
  finished_at: string | null;
  duration_min: number | null;
  run_url: string | null;
  failure_stage: string | null;
  failure_class: string | null;
}

const buildHistoryPath = path.join(process.cwd(), 'docs', 'data', 'history', 'build-runs.ndjson');
const buildHistorySourceUrl = `${baseUrl}data/history/build-runs.ndjson`;
const buildHistoryNow = Date.now();
const buildHistoryWindowStart = buildHistoryNow - 7 * 24 * 60 * 60 * 1000;

const loadPublishBuildHistory = (): PublishBuildRun[] => {
  if (!existsSync(buildHistoryPath)) return [];
  return readFileSync(buildHistoryPath, 'utf8').split('\n').flatMap((line) => {
    if (!line.trim()) return [];
    try {
      const record = JSON.parse(line);
      const startedAt = Date.parse(record?.started_at);
      if (
        !record ||
        !['publish', 'lab'].includes(record.plane) ||
        !['passed', 'failed', 'running'].includes(record.status) ||
        typeof record.lane !== 'string' ||
        typeof record.run_id !== 'string' ||
        !Number.isFinite(startedAt)
      ) return [];
      const recordedAt = typeof record.recorded_at === 'string' && Number.isFinite(Date.parse(record.recorded_at))
        ? record.recorded_at
        : record.started_at;
      return [{
        recorded_at: recordedAt,
        plane: 'publish' as const,
        repo: typeof record.repo === 'string' ? record.repo : 'unknown',
        lane: record.lane,
        run_id: record.run_id,
        status: record.status,
        started_at: record.started_at,
        finished_at: typeof record.finished_at === 'string' ? record.finished_at : null,
        duration_min: typeof record.duration_min === 'number' && Number.isFinite(record.duration_min)
          ? record.duration_min
          : null,
        run_url: typeof record.run_url === 'string' ? record.run_url : null,
        failure_stage: typeof record.failure_stage === 'string' ? record.failure_stage : null,
        failure_class: typeof record.failure_class === 'string' ? record.failure_class : null,
      }];
    } catch {
      return [];
    }
  });
};

const allPublishBuildHistory = loadPublishBuildHistory();
const publishBuildHistoryByKey = new Map<string, PublishBuildRun>();
for (const run of allPublishBuildHistory) {
  const key = `${run.plane}:${run.run_id}`;
  const existing = publishBuildHistoryByKey.get(key);
  if (
    !existing
    || Date.parse(run.recorded_at) >= Date.parse(existing.recorded_at)
  ) {
    publishBuildHistoryByKey.set(key, run);
  }
}
// The NDJSON history is the unified source for both GHA publish and Argo lab
// runs. Keep the legacy variable name for the existing homepage payload.
const publishBuildHistory = [...publishBuildHistoryByKey.values()].filter((run) => {
  const startedAt = Date.parse(run.started_at);
  return startedAt >= buildHistoryWindowStart && startedAt <= buildHistoryNow;
});
const completedPublishBuilds = publishBuildHistory.filter((run) => run.status === 'passed' || run.status === 'failed');
const passedPublishBuilds = completedPublishBuilds.filter((run) => run.status === 'passed');
const failedPublishBuilds = completedPublishBuilds.filter((run) => run.status === 'failed');
const runningPublishBuilds = publishBuildHistory.filter((run) => run.status === 'running');
const labBuilds = publishBuildHistory.filter((run) => run.plane === 'lab');
const ghaBuilds = publishBuildHistory.filter((run) => run.plane === 'publish');
const buildHistoryLastUpdated = publishBuildHistory.reduce<string | null>((latest, run) => {
  if (!latest || Date.parse(run.recorded_at) > Date.parse(latest)) return run.recorded_at;
  return latest;
}, null);
const durations = completedPublishBuilds
  .map((run) => run.duration_min)
  .filter((duration): duration is number => duration !== null && duration >= 0);
const sortedDurations = [...durations].sort((a, b) => a - b);
const percentile = (values: number[], p: number) => {
  if (!values.length) return null;
  const sorted = [...values].sort((a, b) => a - b);
  const index = (sorted.length - 1) * p;
  const lower = Math.floor(index);
  const upper = Math.ceil(index);
  return lower === upper ? sorted[lower] : sorted[lower] + (sorted[upper] - sorted[lower]) * (index - lower);
};
const medianDuration = sortedDurations.length
  ? sortedDurations.length % 2 === 0
    ? (sortedDurations[sortedDurations.length / 2 - 1] + sortedDurations[sortedDurations.length / 2]) / 2
    : sortedDurations[Math.floor(sortedDurations.length / 2)]
  : null;
const p95Duration = percentile(sortedDurations, 0.95);
const averageDuration = durations.length
  ? durations.reduce((sum, duration) => sum + duration, 0) / durations.length
  : null;
const publishSuccessRate = completedPublishBuilds.length
  ? Math.round((passedPublishBuilds.length / completedPublishBuilds.length) * 100)
  : null;
const buildOutcomeDays = Array.from({ length: 7 }, (_, index) => {
  const date = new Date(buildHistoryNow - (6 - index) * 24 * 60 * 60 * 1000).toISOString().slice(0, 10);
  const dayRuns = completedPublishBuilds.filter((run) => new Date(run.started_at).toISOString().slice(0, 10) === date);
  return {
    date,
    passed: dayRuns.filter((run) => run.status === 'passed').length,
    failed: dayRuns.filter((run) => run.status === 'failed').length,
  };
});
const buildHealthPayload = {
  source: buildHistorySourceUrl,
  provenance: {
    publish: 'GitHub Actions workflow runs',
    lab: 'Argo Workflow run history',
    duration_metric: 'lab_build_workflow_duration_seconds (seconds; NDJSON duration_min is derived / 60)',
    completion_metric: 'lab_build_workflow_completed_total (counter by pipeline/status)',
  },
  window_start: new Date(buildHistoryWindowStart).toISOString(),
  window_end: new Date(buildHistoryNow).toISOString(),
  last_updated: buildHistoryLastUpdated,
  sample_count: publishBuildHistory.length,
  planes: {
    publish: { passed: ghaBuilds.filter((run) => run.status === 'passed').length, failed: ghaBuilds.filter((run) => run.status === 'failed').length, running: ghaBuilds.filter((run) => run.status === 'running').length },
    lab: { passed: labBuilds.filter((run) => run.status === 'passed').length, failed: labBuilds.filter((run) => run.status === 'failed').length, running: labBuilds.filter((run) => run.status === 'running').length },
  },
  outcomes: buildOutcomeDays,
};
const serializedBuildHealthData = serializeJsonScript(buildHealthPayload);
const buildHealthUnavailableReason = !existsSync(buildHistoryPath)
  ? 'docs/data/history/build-runs.ndjson is missing.'
  : 'No terminal publish build records were found in the rolling 7-day UTC window.';

// Parse data
const runs = Array.isArray(stats?.recent_runs) ? stats.recent_runs : [];
const openBugs = Array.isArray(stats?.open_bugs) ? stats.open_bugs : [];
const clusterNodes = stats?.factory?.cluster?.nodes || [];
const images = stats?.factory?.images || {};
const testCoverageTotal = stats?.test_coverage?.scenarios_total || 0;
const testCoverageFailed = stats?.test_coverage?.scenarios_failed || 0;
// Canonical image-status contract: upstream-status.json drives ALL image cards
const upstreamRows = Array.isArray(upstreamStatus?.rows) ? upstreamStatus.rows : [];
const testsRows = Array.isArray(testsMatrix?.rows) ? testsMatrix.rows : [];

// Human-readable display names per variant slug
const variantDisplayNames: Record<string, string> = {
  'bluefin':      'Bluefin',
  'bluefin-lts':  'Bluefin LTS',
  'aurora':       'Aurora',
  'bazzite':      'Bazzite',
  'dakota':       'Dakota',
  'cosmic':       'COSMIC',
  'gnomeos':      'GNOME OS',
  'fedora-bootc': 'Fedora bootc',
  'snosi':        'Snow (SNOSI)',
  'snow':         'Snow (SNOSI)',
  'zirconium':    'Zirconium',
};

// Group rows by variant; preserve insertion order from JSON for stable card ordering
const variantMap = new Map<string, typeof upstreamRows>();
for (const row of upstreamRows) {
  if (!row?.variant) continue;
  if (!variantMap.has(row.variant)) variantMap.set(row.variant, []);
  variantMap.get(row.variant)!.push(row);
}

// Build one card per variant from the canonical upstream-status rows
const imageCards = Array.from(variantMap.entries()).map(([variant, rows]) => {
  const firstRow = rows[0];
  const repo = firstRow?.publisher_repo ?? (images as Record<string, { repo?: string }>)[variant]?.repo ?? null;
  const displayName = variantDisplayNames[variant] ?? variant;
  const branches = rows.map((row) => {
    const branch = row.branch as string;
    const suites = testsRows
      .filter((tr) => tr.variant === variant && tr.branch === branch)
      .map((tr) => ({
        id: tr.id,
        suite: tr.suite,
        result_status: tr.result_status,
        pass_rate: tr.pass_rate,
      }));
    return {
      branch,
      state:       row.state as string,
      stateReason: (row.state_reason as string | null) ?? null,
      age:         (row.freshness_age_days as number | null) ?? null,
      seenAt:      (row.published_at as string | null) ?? null,
      sourceUrl:   (row.source_url as string | null) ?? null,
      suites,
    };
  });
  return { variant, displayName, repo, branches };
});

const fabric = copy?.fabric || {};
const fabricLinks = Array.isArray(fabric?.links) ? fabric.links.filter((link) => link?.from && link?.to) : [];
const nodeLinksByName = new Map();
for (const link of fabricLinks) {
  const from = String(link.from);
  const to = String(link.to);
  const speed = link.speed_gbps ? `${link.speed_gbps}G` : 'link';
  const status = link.status || 'unknown';
  const sourceUrl = link.source_url || null;
  if (!nodeLinksByName.has(from)) nodeLinksByName.set(from, []);
  if (!nodeLinksByName.has(to)) nodeLinksByName.set(to, []);
  nodeLinksByName.get(from).push({ peer: to, speed, status, sourceUrl });
  nodeLinksByName.get(to).push({ peer: from, speed, status, sourceUrl });
}

const telemetrySnapshot = telemetry?.snapshot || {};
const fleetDigestAge = Array.isArray(fleetTelemetry?.digest_age) ? fleetTelemetry.digest_age : [];
const fleetUpstreamLag = Array.isArray(fleetTelemetry?.upstream_lag) ? fleetTelemetry.upstream_lag : [];
const fleetWorkloadHealth = Array.isArray(fleetTelemetry?.workload_health) ? fleetTelemetry.workload_health : [];
const fleetVersionHistogram = Array.isArray(fleetTelemetry?.active_version_histogram) ? fleetTelemetry.active_version_histogram : [];

const getNodeStatusTone = (status) => (status === 'ready' ? 'ready' : 'not-ready');
const formatNodeStatus = (status) => (status === 'ready' ? 'Ready' : 'Not ready');

// Calculate summary metrics
const totalRunsCount = runs.length;
const passedRunsCount = runs.filter((r) => r.overall === 'passed').length;
const runningRunsCount = runs.filter((r) => r.overall === 'running').length;
const failedRunsCount = runs.filter((r) => r.overall === 'fail').length;

// Helpers
const formatUtc = (value: string | null) =>
  value
    ? new Date(value).toLocaleString('en-US', {
        dateStyle: 'medium',
        timeStyle: 'short',
        timeZone: 'UTC',
      }) + ' UTC'
    : 'Never';

const getAgeTone = (days: number | null, limit: number) => {
  if (days === null) return 'pending';
  return days > limit ? 'failed' : 'passed';
};

const nodeSpecs: Record<string, { cpu: string; gpu: string; ip: string; details: string }> = {
  ghost: {
    cpu: "Ryzen AI MAX+ 395 (16c/32t)",
    gpu: "RDNA 3.5 (gfx1151) · ROCm AMDGPU enabled",
    ip: "192.168.1.102",
    details: "Control-plane + KubeVirt compute host. Pinned for local Qwen3.6 LLM inference and ARC runners."
  },
  'exo-0': {
    cpu: "Dedicated worker host (16c/32t)",
    gpu: "Headless console",
    ip: "192.168.1.170",
    details: "Always-on dedicated worker node. Schedules KubeVirt virt-launcher test VMs and system-upgrade controllers."
  },
  'exo-1': {
    cpu: "Dakota Laptop (22c worker)",
    gpu: "Integrated GPU",
    ip: "192.168.1.239",
    details: "Opt-in development laptop worker. Joined/left via home Justfile controls."
  },
  'exo-2': {
    cpu: "Flatcar Sysext Node",
    gpu: "Headless console",
    ip: "192.168.1.171",
    details: "Dedicated worker running Flatcar Container Linux with k3s via systemd-sysext. Auto kernel updates via Nebraska."
  },
  hamilton: {
    cpu: "Ryzen Workstation (16c/32t)",
    gpu: "Integrated GPU",
    ip: "192.168.1.225",
    details: "Opt-in Bluefin workstation worker. Sleep-inhibitor systemd service prevents suspend while connected."
  },
  bazzite: {
    cpu: "Gaming Desktop Node",
    gpu: "Dedicated GPU",
    ip: "192.168.1.223",
    details: "Offline worker. Reconnects as gaming machine permits."
  }
};

// ── Release verdict (ADR 0002) ─────────────────────────────────
const verdictRows = Array.isArray(releaseVerdict?.rows) ? releaseVerdict.rows : [];
const verdictGeneratedAt = releaseVerdict?._meta?.generated_at || null;
const verdictToneMap: Record<string, string> = { good: 'passed', bad: 'failed', pending: 'pending' };
const inputToneMap: Record<string, string> = { passed: 'passed', failed: 'failed', pending: 'pending', unavailable: 'pending' };

// ── Build duration / pass-fail sparklines from real GHA run history ──
const laneSparkKeys = [
  ['bluefin-stable', 'bluefin:stable'],
  ['bluefin-testing', 'bluefin:testing'],
  ['bluefin-lts-stable', 'bluefin-lts:stable'],
  ['bluefin-lts-testing', 'bluefin-lts:testing'],
  ['dakota', 'dakota'],
] as const;
const imageBuilds = (stats?.image_builds || {}) as Record<string, Array<{ overall?: string; started_at?: string; duration_min?: number; run_url?: string }>>;
const laneSparks = laneSparkKeys.map(([key, label]) => {
  const runs = (imageBuilds[key] || []).filter((r) => r.started_at).slice(-20);
  return {
    key,
    label,
    points: runs.map((r) => ({
      t: r.started_at,
      duration: r.duration_min ?? null,
      passed: r.overall === 'passed',
      url: r.run_url || null,
    })),
  };
}).filter((s) => s.points.length > 0);

// ── "What's degrading" — computed from real inputs only ─────────
const degrading: Array<{ label: string; detail: string; tone: string; href: string | null }> = [];
for (const row of verdictRows) {
  if (row.verdict === 'bad') {
    const failedInputs = ['build', 'qa', 'signature']
      .filter((k) => row[k]?.status === 'failed')
      .map((k) => `${k}: ${row[k]?.reason || 'failed'}`);
    degrading.push({
      label: `${row.lane} release is bad`,
      detail: failedInputs.join(' · ') || 'one or more verdict inputs failed',
      tone: 'failed',
      href: row.build?.run_url || row.source_url || null,
    });
  }
  if (row.qa?.status === 'pending' && row.qa?.reason) {
    degrading.push({
      label: `${row.lane} QA evidence stale`,
      detail: row.qa.reason,
      tone: 'pending',
      href: null,
    });
  }
}
for (const spark of laneSparks) {
  const pts = spark.points;
  if (pts.length >= 6) {
    const half = Math.floor(pts.length / 2);
    const avg = (arr: typeof pts) => arr.reduce((s, p) => s + (p.duration || 0), 0) / (arr.length || 1);
    const older = avg(pts.slice(0, half));
    const recent = avg(pts.slice(half));
    if (older > 0 && recent > older * 1.3) {
      degrading.push({
        label: `${spark.label} build duration trending up`,
        detail: `recent runs average ${recent.toFixed(0)}m vs ${older.toFixed(0)}m before (+${Math.round(100 * (recent - older) / older)}%)`,
        tone: 'pending',
        href: null,
      });
    }
  }
  const lastThree = pts.slice(-3);
  const failStreak = lastThree.length >= 2 && lastThree.every((p) => !p.passed);
  if (failStreak) {
    degrading.push({
      label: `${spark.label} publishing builds failing`,
      detail: `last ${lastThree.length} runs failed`,
      tone: 'failed',
      href: lastThree[lastThree.length - 1].url,
    });
  }
}
for (const row of upstreamRows) {
  const ageLimit = (row.branch === 'testing' || row.branch === 'nightly') ? 7 : 14;
  if (row.state === 'available' && typeof row.freshness_age_days === 'number' && row.freshness_age_days > ageLimit && row.group === 'projectbluefin') {
    degrading.push({
      label: `${row.variant}:${row.branch} release freshness`,
      detail: `${row.freshness_age_days}d since last published release (threshold ${ageLimit}d)`,
      tone: 'pending',
      href: (row.source_url as string) || null,
    });
  }
}

const triageSparkPayload = { lanes: laneSparks };
const serializedTriageSparkData = serializeJsonScript(triageSparkPayload);

// BuildStream / remote-execution cache usage across both cache drives
const bstCacheRows = Array.isArray(bstCache?.rows) ? bstCache.rows : [];
const bstCacheGeneratedAt = bstCache?._meta?.generated_at || null;
const bstCacheHistoryPath = path.join(process.cwd(), 'docs', 'data', 'history', 'cache-heat.ndjson');
const bstCacheHistory = existsSync(bstCacheHistoryPath)
  ? readFileSync(bstCacheHistoryPath, 'utf8').split('\n').flatMap((line) => {
      if (!line.trim()) return [];
      try {
        const record = JSON.parse(line);
        return record && typeof record === 'object' && record.recorded_at ? [record] : [];
      } catch {
        return [];
      }
    })
  : [];
const bstDrives = ['ghost', 'exo-0'];
const bstCells = bstDrives.map((node) => ['bazel-remote:cas', 'buildbarn:cas', 'buildbarn:ac'].map((key) => {
  const [backend, storageType] = key.split(':');
  const row = bstCacheRows.find((r) => r.node === node && r.cache_backend === backend && r.storage_type === storageType);
  return row || { node, cache_backend: backend, storage_type: storageType, state: 'unavailable', state_reason: 'no cache instance scheduled on this node', percent: null, used_bytes: null, capacity_bytes: null };
}));
const bstChartPayload = {
  drives: bstDrives,
  caches: ['bazel-remote CAS', 'Buildbarn CAS', 'Buildbarn AC'],
  cells: bstCells,
  trend: bstCacheHistory,
};
const serializedBstChartData = serializeJsonScript(bstChartPayload);
const hasBstTrend = bstChartPayload.trend.length > 0;

const usb4Telemetry = bstCache?.usb4_telemetry && typeof bstCache.usb4_telemetry === 'object'
  ? bstCache.usb4_telemetry
  : {};
const usb4Status = typeof usb4Telemetry.status === 'string' ? usb4Telemetry.status : 'unavailable';
const usb4StatusTone = usb4Status === 'up' ? 'ready' : usb4Status === 'down' ? 'not-ready' : 'pending';
const usb4MeasuredRows = [
  ['Cold build', usb4Telemetry.cold_build_duration_min, 'min'],
  ['Warm build', usb4Telemetry.warm_build_duration_min, 'min'],
  ['Speedup', usb4Telemetry.speedup_ratio, '×'],
  ['Layer rechunk', usb4Telemetry.rechunk_duration_sec, 'sec'],
  ['ghost work', usb4Telemetry.work_distribution?.ghost, '%'],
  ['exo-0 work', usb4Telemetry.work_distribution?.['exo-0'], '%'],
].filter(([, value]) => typeof value === 'number' && Number.isFinite(value));
const usb4HasMeasuredTelemetry = usb4MeasuredRows.length > 0;
const usb4EvidenceUrl = typeof usb4Telemetry.source_url === 'string' && /^https?:\/\//.test(usb4Telemetry.source_url)
  ? usb4Telemetry.source_url
  : null;
const usb4CollectedAt = typeof usb4Telemetry.collected_at === 'string' ? usb4Telemetry.collected_at : null;
const usb4ObservedAt = usb4Telemetry.ghost_observed_at || usb4Telemetry.exo0_observed_at || null;
const usb4UnavailableReason = typeof usb4Telemetry.state_reason === 'string'
  ? usb4Telemetry.state_reason
  : 'No producer has published measured distributed-execution telemetry.';
const usb4ExecutionPayload = {
  nodes: Array.isArray(usb4Execution?.nodes) ? usb4Execution.nodes : ['ghost', 'exo-0'],
  windowStart: usb4Execution?._meta?.window_start || null,
  windowEnd: usb4Execution?._meta?.window_end || null,
  rows: Array.isArray(usb4Execution?.rows) ? usb4Execution.rows : [],
};
const serializedUsb4ExecutionData = serializeJsonScript(usb4ExecutionPayload);

---

<SiteLayout
  title="Factory Overview Dashboard"
  description="Statically prerendered overview dashboard showing live contributor clusters, image release freshness, test coverage, and telemetry pipeline lineage."
  current="overview"
  includeDashboardAssets={false}
>
  <style>
    /* ── Dashboard Header ─────────────────────────────────────── */
    .dashboard-header {
      margin-bottom: 2rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      padding-bottom: 1.5rem;
    }
    .dashboard-header h1 {
      font-size: 2.25rem;
      font-weight: 800;
      letter-spacing: -0.04em;
      margin: 0 0 0.5rem 0;
      background: linear-gradient(135deg, #f8fafc 30%, #94a3b8 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .meta-bar {
      font-size: 0.85rem;
      color: #94a3b8;
      display: flex;
      gap: 1.5rem;
      flex-wrap: wrap;
    }
    .meta-bar a { color: #38bdf8; text-decoration: none; }
    .meta-bar a:hover { text-decoration: underline; }

    /* ── SRE Triage ─────────────────────────────────────────── */
    .verdict-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 1rem;
      margin-bottom: 2.5rem;
    }
    .verdict-card {
      background: linear-gradient(180deg, rgba(30, 41, 59, 0.45) 0%, rgba(15, 23, 42, 0.6) 100%);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 16px;
      padding: 1.1rem 1.25rem;
      display: flex;
      flex-direction: column;
      gap: 0.7rem;
    }
    .verdict-card--good { border-color: rgba(16, 185, 129, 0.35); }
    .verdict-card--bad { border-color: rgba(244, 63, 94, 0.45); background: linear-gradient(135deg, rgba(244, 63, 94, 0.08) 0%, rgba(15, 23, 42, 0.65) 100%); }
    .verdict-card--pending { border-color: rgba(245, 158, 11, 0.3); }
    .verdict-inputs { display: flex; flex-wrap: wrap; gap: 0.4rem; }
    .verdict-input {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      font-size: 0.68rem;
      font-weight: 600;
      color: #94a3b8;
      background: rgba(15, 23, 42, 0.6);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 999px;
      padding: 0.18rem 0.55rem;
    }
    .verdict-input__dot { width: 7px; height: 7px; border-radius: 50%; background: #64748b; }
    .verdict-input--passed .verdict-input__dot { background: #4ade80; }
    .verdict-input--failed .verdict-input__dot { background: #f43f5e; }
    .verdict-input--pending .verdict-input__dot { background: #fbbf24; }
    .verdict-meta { display: flex; justify-content: space-between; gap: 0.5rem; font-size: 0.72rem; color: #64748b; }
    .verdict-meta .mono { font-family: ui-monospace, monospace; }
    .verdict-note { font-size: 0.7rem; color: #fbbf24; line-height: 1.45; }
    .spark-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 1rem;
      margin-bottom: 2.5rem;
    }
    .spark-card {
      background: linear-gradient(180deg, rgba(30, 41, 59, 0.4) 0%, rgba(15, 23, 42, 0.6) 100%);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 16px;
      padding: 0.9rem 1rem 0.5rem 1rem;
    }
    .degrading-panel {
      background: linear-gradient(180deg, rgba(30, 41, 59, 0.35) 0%, rgba(15, 23, 42, 0.55) 100%);
      border: 1px solid rgba(255, 255, 255, 0.07);
      border-radius: 16px;
      padding: 0.75rem 1.25rem;
      margin-bottom: 2.5rem;
    }

    /* ── Section Titles ──────────────────────────────────────── */
    .section-title {
      font-size: 1.1rem;
      font-weight: 700;
      color: #cbd5e1;
      margin: 2.5rem 0 1rem 0;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      border-left: 3px solid #38bdf8;
      padding-left: 10px;
    }

    /* ── KPI Grid ───────────────────────────────────────────── */
    .kpi-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 1rem;
      margin-bottom: 2.5rem;
    }
    .kpi-card {
      background: linear-gradient(180deg, rgba(30, 41, 59, 0.4) 0%, rgba(15, 23, 42, 0.6) 100%);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 16px;
      padding: 1.25rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      min-height: 130px;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .kpi-card:hover {
      border-color: rgba(56, 189, 248, 0.3);
      transform: translateY(-3px);
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
    }
    .kpi-card--success {
      background: linear-gradient(135deg, rgba(16, 185, 129, 0.12) 0%, rgba(15, 23, 42, 0.65) 100%);
      border-color: rgba(16, 185, 129, 0.25);
    }
    .kpi-card--success:hover { border-color: rgba(16, 185, 129, 0.45); }
    .kpi-card--warning {
      background: linear-gradient(135deg, rgba(245, 158, 11, 0.1) 0%, rgba(15, 23, 42, 0.65) 100%);
      border-color: rgba(245, 158, 11, 0.2);
    }
    .kpi-card--warning:hover { border-color: rgba(245, 158, 11, 0.4); }

    .kpi-card__title {
      font-size: 0.78rem;
      font-weight: 700;
      color: #94a3b8;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .kpi-card__value {
      font-size: 2rem;
      font-weight: 800;
      color: #f8fafc;
      letter-spacing: -0.04em;
      margin: 0.5rem 0 0.2rem 0;
    }
    .kpi-card__sub {
      font-size: 0.72rem;
      color: #64748b;
    }

    /* ── Node/Cluster Panel ─────────────────────────────────── */
    .nodes-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 1.6rem;
      margin-bottom: 2.5rem;
      padding: 0.35rem 0.25rem;
    }
    .node-card {
      background: linear-gradient(180deg, rgba(30, 41, 59, 0.45) 0%, rgba(15, 23, 42, 0.6) 100%);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 20px;
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 12px;
      transition: all 0.3s ease;
    }
    .node-card:hover {
      border-color: rgba(56, 189, 248, 0.25);
      transform: translateY(-2px);
    }
    .node-card header {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .node-card h3 {
      margin: 0;
      font-size: 1.15rem;
      font-weight: 700;
      color: #f1f5f9;
    }
    .node-role {
      font-size: 0.8rem;
      color: #94a3b8;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .node-gauge-row {
      display: grid;
      grid-template-columns: 4rem 1fr 3.5rem;
      gap: 10px;
      align-items: center;
      font-size: 0.82rem;
    }
    .node-gauge-bar {
      width: 100%;
      height: 8px;
      border-radius: 999px;
      background: rgba(15, 23, 42, 0.72);
      border: 1px solid rgba(255, 255, 255, 0.08);
      overflow: hidden;
    }
    .node-gauge-bar > span {
      display: block;
      height: 100%;
      background: linear-gradient(90deg, #38bdf8, #a78bfa);
    }
    .node-meta {
      font-size: 0.78rem;
      color: #64748b;
      margin-top: 0.35rem;
    }

    /* ── Image Status Grid ──────────────────────────────────── */
    .image-status-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 1rem;
      margin-bottom: 2.5rem;
    }
    .image-status-card {
      background: linear-gradient(180deg, rgba(30, 41, 59, 0.45) 0%, rgba(15, 23, 42, 0.6) 100%);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 18px;
      padding: 1.25rem;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .image-status-card h3 {
      margin: 0;
      font-size: 1.1rem;
      font-weight: 700;
      color: #f1f5f9;
    }
    .pulse-stats {
      display: flex;
      gap: 1.5rem;
    }
    .pulse-stat {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
    .pulse-stat-value {
      font-size: 1.5rem;
      font-weight: 800;
    }
    .pulse-stat-value.tone-good { color: #4ade80; }
    .pulse-stat-value.tone-warn { color: #fbbf24; }
    .pulse-stat-value.tone-bad  { color: #fb7185; }
    .pulse-stat-value.tone-passed { color: #4ade80; }
    .pulse-stat-value.tone-failed { color: #fb7185; }
    .pulse-stat-value.tone-pending { color: #fbbf24; }
    .pulse-stat-name {
      font-size: 0.7rem;
      color: #64748b;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .pulse-stat-detail {
      font-size: 0.68rem;
      color: #94a3b8;
      line-height: 1.25;
      max-width: 12rem;
    }
    
    /* Mini BDD test pills on homepage image cards */
    .mini-test-pill {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      background: rgba(15, 23, 42, 0.45);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 6px;
      padding: 2px 6px;
      font-size: 0.68rem;
      font-weight: 600;
      color: #94a3b8;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .mini-test-pill:hover {
      background: rgba(30, 41, 59, 0.75);
      border-color: rgba(56, 189, 248, 0.3);
      color: #f1f5f9;
      transform: translateY(-0.5px);
    }
    .suite-status-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      display: inline-block;
    }
    .mini-test-pill.status--passed .suite-status-dot {
      background-color: #10b981;
      box-shadow: 0 0 6px rgba(16, 185, 129, 0.6);
    }
    .mini-test-pill.status--failed .suite-status-dot {
      background-color: #f43f5e;
      box-shadow: 0 0 6px rgba(244, 63, 94, 0.6);
    }
    .mini-test-pill.status--unavailable .suite-status-dot {
      background-color: #64748b;
    }
    .node-links {
      margin-top: 0.5rem;
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
    }
    .node-link {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 999px;
      padding: 0.2rem 0.55rem;
      font-size: 0.72rem;
      color: #cbd5e1;
      text-decoration: none;
    }
    .node-link--up {
      border-color: rgba(34, 197, 94, 0.5);
      color: #86efac;
    }
    .node-link--warn {
      border-color: rgba(245, 158, 11, 0.45);
      color: #fcd34d;
    }

    /* ── Fabric SVG overlay ─────────────────────────────────── */
    #cluster-canvas-wrap {
      position: relative;
      padding-top: 2.5rem;
    }
    #fabric-svg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      overflow: visible;
      z-index: 10;
    }

    /* ── Dense Lists ────────────────────────────────────────── */
    .lists-split {
      display: grid;
      grid-template-columns: 1.3fr 0.7fr;
      gap: 1.5rem;
      margin-bottom: 2.5rem;
    }
    @media (max-width: 900px) {
      .lists-split {
        grid-template-columns: 1fr;
      }
    }
    .dense-panel {
      background: rgba(15, 23, 42, 0.4);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 20px;
      padding: 1.5rem;
    }
    .dense-panel h2 {
      font-size: 1.25rem;
      font-weight: 800;
      color: #cbd5e1;
      margin: 0 0 1rem 0;
    }
    .dense-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .dense-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 10px 12px;
      background: rgba(30, 41, 59, 0.25);
      border: 1px solid rgba(255, 255, 255, 0.04);
      border-radius: 12px;
      font-size: 0.88rem;
    }
    .dense-row:hover {
      background: rgba(255, 255, 255, 0.02);
    }
    .dense-row a {
      color: #38bdf8;
      text-decoration: none;
      font-weight: 600;
    }
    .dense-row a:hover {
      text-decoration: underline;
    }
    .bug-meta {
      font-size: 0.75rem;
      color: #64748b;
    }

    /* ── Shell element keeps matching tests ─────────────────── */
    #factory-dashboard {
      display: block;
    }

    @keyframes sizzle {
      0% { filter: brightness(1.0); box-shadow: 0 0 2px rgba(244, 63, 94, 0.4); }
      50% { filter: brightness(1.2); box-shadow: 0 0 8px rgba(249, 115, 22, 0.6); }
      100% { filter: brightness(1.0); box-shadow: 0 0 2px rgba(244, 63, 94, 0.4); }
    }
    .heat-bar-container {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: 999px;
      width: 100px;
      height: 6px;
      margin-top: 0.25rem;
      overflow: hidden;
    }
    .heat-glowing-bar {
      border-radius: 999px;
      height: 100%;
      animation: sizzle 2.5s ease-in-out infinite;
    }
    .heat-col-layout {
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .chart-panel-custom {
      background: rgba(15, 23, 42, 0.45);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 20px;
      padding: 1.5rem;
      margin-top: 1rem;
    }
    .chart-box-custom {
      width: 100%;
      height: 280px;
      min-height: 280px;
    }
    .registry-flex-layout {
      display: grid;
      grid-template-columns: 1.2fr 1.8fr;
      gap: 1.5rem;
      align-items: start;
    }
    @media (max-width: 960px) {
      .registry-flex-layout {
        grid-template-columns: 1fr;
      }
    }

    /* TB4 Dash animations */
    @keyframes tb4-dash-fwd { to { stroke-dashoffset: -28; } }
    @keyframes tb4-dash-rev { to { stroke-dashoffset: 28; } }
  </style>

  <div id="factory-dashboard">
    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--  HEADER                                                     -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <header class="dashboard-header">
      <h1>{copy.brand.title}</h1>
      <div class="meta-bar">
        <span>Updated {formatUtc(stats?._meta?.generated)}</span>
        <span>Source: projectbluefin core metrics & feeds</span>
        <span>Snapshot: <span style={`color: ${telemetrySnapshot.state === 'fresh' ? '#4ade80' : '#fbbf24'};`}>{telemetrySnapshot.state || 'unknown'}</span></span>
        <a href={`${baseUrl}data/factory-stats.json`}>Raw dataset ↗</a>
      </div>
    </header>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--  SRE TRIAGE — is the factory healthy? is the last release   -->
    <!--  good? what's degrading? (ADR 0002)                          -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <h2 class="section-title">Is the last release good?</h2>
    <p class="section-sub" style="margin-top: -0.5rem; margin-bottom: 1.5rem; color: #64748b; font-size: 0.9rem;">
      Per-lane verdict under <a href="https://github.com/projectbluefin/lab/blob/main/docs/adr/0002-release-verdict-definition.md" style="color:#38bdf8; text-decoration:none;">ADR 0002</a>:
      publishing build + lab QA on the exact digest + cosign signature. Security regression shown alongside, never gating.
      {verdictGeneratedAt && <span> Collected {formatUtc(verdictGeneratedAt)}.</span>}
    </p>
    <div class="verdict-grid">
      {verdictRows.map((row) => (
        <article class={`verdict-card verdict-card--${row.verdict}`}>
          <header style="display:flex; justify-content:space-between; align-items:center;">
            <h3 style="margin:0; font-size:1rem; color:#f1f5f9;">{row.lane}</h3>
            <span class={`pill pill--${verdictToneMap[row.verdict] === 'passed' ? 'completed' : verdictToneMap[row.verdict]}`} style="text-transform:uppercase; font-weight:700;">
              {row.verdict}
            </span>
          </header>
          <div class="verdict-inputs">
            {(['build', 'qa', 'signature'] as const).map((k) => {
              const input = row[k] || {};
              const tone = inputToneMap[input.status] || 'pending';
              const title = input.reason || (k === 'qa' ? 'lab-sourced evidence' : input.status);
              return (
                <span class={`verdict-input verdict-input--${tone}`} title={title}>
                  <span class="verdict-input__dot"></span>
                  {k === 'qa' ? 'QA (lab)' : k}: {input.status}
                </span>
              );
            })}
            <span class="verdict-input verdict-input--pending" title={row.security_regression?.reason || 'unavailable'}>
              <span class="verdict-input__dot"></span>
              CVE regression: {row.security_regression?.status || 'unavailable'}
            </span>
          </div>
          <div class="verdict-meta">
            {row.digest ? (
              <span class="mono" title={row.digest}>{row.digest.slice(0, 19)}…</span>
            ) : (
              <span style="color:#fbbf24;">{row.state_reason || 'digest unavailable'}</span>
            )}
            {row.build?.run_url && (
              <a href={row.build.run_url} target="_blank" rel="noreferrer" style="color:#38bdf8; text-decoration:none;">build run ↗</a>
            )}
          </div>
          {row.qa?.status === 'pending' && row.qa?.reason && (
            <div class="verdict-note">{row.qa.reason}</div>
          )}
        </article>
      ))}
      {verdictRows.length === 0 && (
        <div style="color:#fbbf24; font-size:0.85rem;">Release verdict dataset unavailable — collector has not published docs/data/release-verdict.json yet.</div>
      )}
    </div>

    <section id="fleet-drift-telemetry">
      <h2 class="section-title">Fleet drift telemetry</h2>
      <p class="section-sub" style="margin-top: -0.5rem; margin-bottom: 1.5rem; color: #64748b; font-size: 0.9rem;">
        Historical, evidence-backed signals for version spread, digest freshness, upstream lag, and Kubernetes workload presence.
        Missing artifact or cluster evidence remains explicitly unavailable.
      </p>
      <div class="kpi-grid">
        <article class="kpi-card">
          <span class="kpi-card__title">Active versions</span>
          <strong class="kpi-card__value">{fleetVersionHistogram.filter((row) => row.state === 'available').length || '—'}</strong>
          <span class="kpi-card__sub">artifact histogram buckets</span>
        </article>
        <article class="kpi-card">
          <span class="kpi-card__title">Stale digests</span>
          <strong class="kpi-card__value">{fleetDigestAge.filter((row) => row.stale === true).length || '—'}</strong>
          <span class="kpi-card__sub">beyond lane freshness threshold</span>
        </article>
        <article class="kpi-card">
          <span class="kpi-card__title">Upstream lag</span>
          <strong class="kpi-card__value">{fleetUpstreamLag.filter((row) => row.state === 'available').length || '—'}</strong>
          <span class="kpi-card__sub">lanes with published age evidence</span>
        </article>
        <article class="kpi-card">
          <span class="kpi-card__title">Workload health</span>
          <strong class="kpi-card__value">{fleetWorkloadHealth.filter((row) => row.health === 'healthy').length || '—'}</strong>
          <span class="kpi-card__sub">workloads with pod snapshots</span>
        </article>
      </div>
      <div class="detail-grid" style="margin-top: 1rem;">
        <article class="detail-card">
          <h3>Digest age and upstream lag</h3>
          <div class="table-scroll">
            <table>
              <thead><tr><th>Lane</th><th>Digest age</th><th>Upstream age</th><th>State</th></tr></thead>
              <tbody>
                {fleetDigestAge.map((digest) => {
                  const upstream = fleetUpstreamLag.find((row) => row.id === digest.lane);
                  return <tr>
                    <td class="mono">{digest.lane || 'unknown'}</td>
                    <td>{digest.digest_age_days != null ? `${digest.digest_age_days}d${digest.stale ? ' · stale' : ''}` : 'Unavailable'}</td>
                    <td>{upstream?.upstream_lag_days != null ? `${upstream.upstream_lag_days}d` : 'Unavailable'}</td>
                    <td>{digest.state === 'available' && upstream?.state === 'available' ? 'Available' : 'Unavailable'}</td>
                  </tr>;
                })}
                {fleetDigestAge.length === 0 && <tr><td colspan="4">No digest age evidence is published.</td></tr>}
              </tbody>
            </table>
          </div>
        </article>
        <article class="detail-card">
          <h3>Kubernetes workload health</h3>
          <div class="table-scroll">
            <table>
              <thead><tr><th>Workload</th><th>Pods</th><th>Health</th></tr></thead>
              <tbody>
                {fleetWorkloadHealth.map((row) => <tr>
                  <td class="mono">{row.workload || 'unknown'}</td>
                  <td>{row.pods_count ?? 'Unavailable'}</td>
                  <td>{row.health || 'Unavailable'}</td>
                </tr>)}
                {fleetWorkloadHealth.length === 0 && <tr><td colspan="3">Kubernetes workload snapshot unavailable.</td></tr>}
              </tbody>
            </table>
          </div>
        </article>
      </div>
      <p style="color:#64748b; font-size:0.75rem; margin-top:0.75rem;">
        Raw evidence: <a href={`${baseUrl}data/fleet-telemetry.json`}>fleet telemetry contract</a> ·
        <a href={`${baseUrl}data/history/active-versions.ndjson`}>active-version history</a> ·
        <a href={`${baseUrl}data/history/digest-age.ndjson`}>digest-age history</a> ·
        <a href={`${baseUrl}data/history/upstream-lag.ndjson`}>upstream-lag history</a> ·
        <a href={`${baseUrl}data/history/workload-health.ndjson`}>workload history</a>
      </p>
    </section>

    <section id="factory-build-health" data-factory-build-health="true">
      <div class="spark-grid" style="display:none;" aria-hidden="true"></div>
      <h2 class="section-title">Rolling 7-day factory build health · unified publish + lab</h2>
      <p class="section-sub" style="margin-top: -0.5rem; margin-bottom: 1.5rem; color: #64748b; font-size: 0.9rem;">
        GitHub Actions publish builds and Argo lab build runs in one explicit UTC window. Release verdict cards above remain a separate per-lane digest, QA, and signature judgment.
      </p>
      <p class="section-sub" style="margin-top: -1rem; margin-bottom: 1.5rem; color: #64748b; font-size: 0.78rem;">
        Window: {formatUtc(new Date(buildHistoryWindowStart).toISOString())} – {formatUtc(new Date(buildHistoryNow).toISOString())} · samples: {publishBuildHistory.length} · last updated: {formatUtc(buildHistoryLastUpdated)}
      </p>
      {completedPublishBuilds.length > 0 || runningPublishBuilds.length > 0 ? (
        <>
          <div class="kpi-grid">
            <article class="kpi-card">
              <span class="kpi-card__title">All factory builds</span>
              <strong class="kpi-card__value">{completedPublishBuilds.length}</strong>
              <span class="kpi-card__sub">completed publish + lab builds</span>
            </article>
            <article class="kpi-card kpi-card--success">
              <span class="kpi-card__title">Passed</span>
              <strong class="kpi-card__value">{passedPublishBuilds.length}</strong>
              <span class="kpi-card__sub">terminal outcomes</span>
            </article>
            <article class="kpi-card kpi-card--warning">
              <span class="kpi-card__title">Failed</span>
              <strong class="kpi-card__value">{failedPublishBuilds.length}</strong>
              <span class="kpi-card__sub">terminal outcomes</span>
            </article>
            <article class="kpi-card">
              <span class="kpi-card__title">Success rate</span>
              <strong class="kpi-card__value">{publishSuccessRate !== null ? `${publishSuccessRate}%` : '—'}</strong>
              <span class="kpi-card__sub">{publishSuccessRate !== null ? 'passed / completed · all planes' : 'terminal metrics unavailable'}</span>
            </article>
            <article class="kpi-card">
              <span class="kpi-card__title">Duration</span>
              <strong class="kpi-card__value">{medianDuration !== null ? `${medianDuration.toFixed(0)}m` : '—'}</strong>
              <span class="kpi-card__sub">{averageDuration !== null ? `p50 ${medianDuration?.toFixed(0)}m · p95 ${p95Duration?.toFixed(0)}m · avg ${averageDuration.toFixed(0)}m` : 'terminal metrics unavailable'}</span>
            </article>
            <article class="kpi-card">
              <span class="kpi-card__title">Running work</span>
              <strong class="kpi-card__value">{runningPublishBuilds.length}</strong>
              <span class="kpi-card__sub">separate in-progress signal</span>
            </article>
          </div>
          {completedPublishBuilds.length === 0 && (
            <article class="spark-card" style="margin-bottom: 1rem;">
              <h3 style="margin:0; color:#fbbf24;">Terminal metrics unavailable</h3>
              <p style="margin:0.5rem 0; color:#94a3b8;">This window contains running publish work but no completed builds to calculate outcomes, success rate, or duration.</p>
              <p style="margin:0; color:#64748b; font-size:0.78rem;">Running work remains visible as the current health signal.</p>
            </article>
          )}
          <article class="spark-card" style="margin-bottom: 1rem;">
            <header style="display:flex; justify-content:space-between; align-items:baseline; gap:1rem; flex-wrap:wrap;">
              <h3 style="margin:0; font-size:0.9rem; color:#cbd5e1;">Seven-day outcomes</h3>
              <a href={`${baseUrl}builds/`} style="color:#38bdf8; text-decoration:none; font-size:0.78rem;">View build evidence →</a>
            </header>
            <p style="margin:0.35rem 0 0; color:#64748b; font-size:0.72rem;">UTC window · {publishBuildHistory.length} samples · last updated {formatUtc(buildHistoryLastUpdated)}</p>
            <div id="factory-build-outcomes-chart" style="height: 150px;" role="img" aria-label="Seven-day passed and failed factory publish build outcomes"></div>
          </article>
        </>
      ) : (
        <article class="spark-card">
          <h3 style="margin:0; color:#fbbf24;">Build health unavailable</h3>
          <p style="margin:0.5rem 0; color:#94a3b8;">{buildHealthUnavailableReason}</p>
          <p style="margin:0; color:#64748b; font-size:0.78rem;">state_reason: {buildHealthUnavailableReason}</p>
        </article>
      )}
      <p style="margin:0; color:#64748b; font-size:0.78rem;">
        Source: <a href={buildHistorySourceUrl} style="color:#38bdf8;">data/history/build-runs.ndjson</a> · planes: publish (GitHub Actions) + lab (Argo) · units: duration minutes in history, source metric seconds · statuses: passed/failed/running · UTC rolling window.
        <span> Completion counts reuse <code>lab_build_workflow_completed_total</code>; duration distributions reuse <code>lab_build_workflow_duration_seconds</code> where Argo metrics are available. Failure stage/class are shown only when published. Missing history renders Build health unavailable with its state_reason.</span>
      </p>
    </section>

    <h2 class="section-title">What's degrading?</h2>
    <div class="degrading-panel">
      {degrading.length === 0 ? (
        <div style="color:#4ade80; font-size:0.9rem; padding: 0.75rem 0;">No degradation signals from tracked inputs — verdicts, build trends, and release freshness are all inside thresholds.</div>
      ) : (
        <div class="dense-list">
          {degrading.map((item) => (
            <div class="dense-row" style="align-items:start;">
              <div style="display:flex; align-items:baseline; gap:10px;">
                <span class={`pill pill--${item.tone === 'failed' ? 'failed' : 'pending'}`} style="padding: 0.2rem 0.5rem; font-size: 0.72rem;">
                  {item.tone === 'failed' ? 'failing' : 'degrading'}
                </span>
                <span style="font-weight:600;">{item.label}</span>
              </div>
              <div style="font-size:0.78rem; color:#94a3b8; text-align:right; max-width: 46ch;">
                {item.href ? <a href={item.href} target="_blank" rel="noreferrer" style="color:#94a3b8;">{item.detail}</a> : item.detail}
              </div>
            </div>
          ))}
        </div>
      )}
    </div>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--  IMAGE STATUS                                               -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <h2 class="section-title">Image status</h2>
    <p class="section-sub" style="margin-top: -0.5rem; margin-bottom: 1.5rem; color: #64748b; font-size: 0.9rem;">
      Days since latest published release in each lane, sourced from each repo's GitHub Releases feed.
    </p>
    <div class="image-status-grid">
      {imageCards.map((card) => {
        const releasesUrl = card.repo ? `https://github.com/${card.repo}/releases` : '';

        return (
          <article class="image-status-card">
            <header style="display: flex; justify-content: space-between; align-items: center;">
              <h3>{card.displayName}</h3>
              {releasesUrl && (
                <a href={releasesUrl} target="_blank" rel="noreferrer" style="font-size: 0.8rem; color: #38bdf8; text-decoration: none;">
                  Releases &rarr;
                </a>
              )}
            </header>
            <div style="display: flex; flex-direction: column; gap: 0.65rem;">
              {card.branches.map((b, i) => {
                const isAvailable = b.state === 'available';
                const ageLimit = (b.branch === 'testing' || b.branch === 'nightly') ? 7 : 14;
                const tone = isAvailable ? getAgeTone(b.age, ageLimit) : 'bad';
                return (
                  <div style={`display: flex; flex-direction: column; gap: 3px;${i > 0 ? ' border-top: 1px solid rgba(255,255,255,0.04); padding-top: 0.6rem;' : ''}`}>
                    <div style="display: flex; align-items: baseline; gap: 0.55rem; flex-wrap: wrap;">
                      <span class={`pulse-stat-value tone-${tone}`} style="font-size: 1.35rem;">
                        {isAvailable && b.age !== null ? `${b.age}d` : '—'}
                      </span>
                      <span class="pulse-stat-name">{b.branch}</span>
                      {!isAvailable && (
                        <span style="font-size: 0.62rem; color: #fbbf24; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;">
                          Awaiting Evidence
                        </span>
                      )}
                    </div>
                    <div class="pulse-stat-detail">
                      {isAvailable && b.seenAt ? (
                        b.sourceUrl ? (
                          <a href={b.sourceUrl} target="_blank" rel="noreferrer" style="color: #64748b; text-decoration: none;">{`Published ${formatUtc(b.seenAt)}`}</a>
                        ) : `Published ${formatUtc(b.seenAt)}`
                      ) : (
                        b.stateReason || 'No release timestamp'
                      )}
                    </div>
                    {b.suites && b.suites.length > 0 && (
                      <div class="branch-tests-row" style="margin-top: 0.5rem; display: flex; flex-wrap: wrap; gap: 0.35rem; align-items: center;">
                        <span style="font-size: 0.65rem; color: #64748b; font-weight: 600; text-transform: uppercase; letter-spacing: 0.03em; margin-right: 2px;">Tests:</span>
                        {b.suites.map((s) => {
                          const suiteAbbr = { smoke: 'smoke', developer: 'dev', software: 'soft', system: 'sys', common: 'common', flatcar: 'flatcar' }[s.suite] || s.suite;
                          return (
                            <a
                              href={`${baseUrl}tests/#${s.id}`}
                              class={`mini-test-pill status--${s.result_status}`}
                              title={`${s.suite} suite: ${s.result_status}${s.pass_rate !== null ? ` (${s.pass_rate}% passing)` : ''}`}
                            >
                              <span>{suiteAbbr}</span>
                              <span class="suite-status-dot"></span>
                            </a>
                          );
                        })}
                      </div>
                    )}
                  </div>
                );
              })}
            </div>
          </article>
        );
      })}
    </div>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--  CONTRIBUTOR CLUSTERS (NODES)                               -->
