    <!--  BST CACHE UTILIZATION ACROSS BOTH DRIVES                   -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <h2 class="section-title">BuildStream Cache Utilization</h2>
    <p class="section-sub" style="margin-top: -0.5rem; margin-bottom: 1.5rem; color: #64748b; font-size: 0.9rem;">
      Remote-execution cache fill across both cache drives: ghost (bazel-remote + Buildbarn shard) and exo-0 (Buildbarn shard).
    </p>
    <div class="nodes-grid">
      <article class="node-card" style="grid-column: 1 / -1; background: linear-gradient(180deg, rgba(30, 41, 59, 0.45) 0%, rgba(15, 23, 42, 0.6) 100%);">
        <header style="margin-bottom: 1rem; display: flex; justify-content: space-between; align-items: center;">
          <div style="display: flex; align-items: center; gap: 0.5rem;">
            <h3>bst Cache Heat Map</h3>
            <span class="pill pill--completed" style="background: rgba(34,197,94,.15); color: #4ade80; padding: 0.15rem 0.5rem; font-size: 0.72rem;">live</span>
          </div>
          <span style="font-size: 0.75rem; color: #64748b;">Collected: {bstCacheGeneratedAt ? formatUtc(bstCacheGeneratedAt) : 'unavailable'}</span>
        </header>
        <p style="font-size: 0.85rem; color: #94a3b8; line-height: 1.6; margin: 0 0 1rem 0;">
          bazel-remote is nodeSelector-pinned to ghost; Buildbarn's 2-shard CAS/AC is scheduled across ghost and exo-0 via podAntiAffinity.
          Buildbarn's block-device-backed storage is preallocated on disk, so its cell values are a derived estimate of logical fill (allocator counters × known block size), not raw disk bytes.
        </p>
        <p style="font-size: 0.78rem; color: #64748b; margin: 0 0 0.75rem;">Heatmap scale: Cache utilization (%) from 0% to 100%; gray cells are unavailable.</p>
        <div id="bst-cache-chart" class="chart-box-custom" style="height: 260px; min-height: 260px;" role="img" aria-label="bst cache utilization heat map across ghost and exo-0"></div>
        <h3 style="margin: 1.5rem 0 0.5rem; font-size: 0.95rem;">Cache heat trend</h3>
        <p id="bst-cache-trend-unavailable" style={`font-size: 0.82rem; color: #fbbf24; margin: 0 0 0.75rem;${hasBstTrend ? ' display:none;' : ''}`}>
          Cache heat trend unavailable: no historical cache snapshots are published yet.
        </p>
        <div id="bst-cache-trend-chart" class="chart-box-custom" style={`height: 220px; min-height: 220px;${hasBstTrend ? '' : ' display:none;'}`} role="img" aria-label="Cache heat trend"></div>
      </article>

      <article class="node-card" style="grid-column: 1 / -1; background: linear-gradient(180deg, rgba(30, 41, 59, 0.45) 0%, rgba(15, 23, 42, 0.6) 100%); margin-top: 1rem;">
        <header style="margin-bottom: 1rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
          <div style="display: flex; align-items: center; gap: 0.75rem;">
            <h3 style="margin: 0; font-size: 1.1rem; font-weight: 700; color: #f1f5f9;">USB-4 Distributed Execution</h3>
            <span class={`pill pill--${usb4StatusTone}`} style="text-transform: uppercase; font-size: 0.72rem; padding: 0.15rem 0.55rem;">
              Link {usb4Status}
            </span>
          </div>
          <span style="font-size: 0.75rem; color: #64748b;">Point-to-point: ghost ↔ exo-0</span>
        </header>

        <p style="font-size: 0.82rem; color: #94a3b8; line-height: 1.5; margin: 0 0 1rem;">
          Cache occupancy above is storage telemetry only; this table reports distributed execution measurements separately.
          Window: {usb4ExecutionPayload.windowStart ? `${formatUtc(usb4ExecutionPayload.windowStart)} → ${formatUtc(usb4ExecutionPayload.windowEnd)}` : 'UTC window unavailable'}.
        </p>
        <div id="usb4-execution-heatmap" class="chart-box-custom" style="height: 280px; min-height: 280px;" role="img" aria-label="USB-4 execution heatmap for ghost and exo-0"></div>
        <p id="usb4-execution-heatmap-unavailable" style="font-size: 0.82rem; color: #fbbf24; margin: 0 0 0.75rem;">
          Execution heatmap unavailable: no measured throughput, latency, action, or cache fields were published.
        </p>
        {!usb4HasMeasuredTelemetry && (
          <div style="border: 1px solid rgba(251, 191, 36, 0.35); background: rgba(120, 53, 15, 0.16); border-radius: 10px; padding: 0.85rem; color: #fde68a; font-size: 0.85rem;">
            <strong>Execution telemetry unavailable.</strong> {usb4UnavailableReason}
          </div>
        )}
        {usb4HasMeasuredTelemetry && (
          <div class="table-scroll">
            <table class="data-table" style="min-width: 36rem;">
              <thead><tr><th>Measured phase / signal</th><th>Value</th><th>Unit</th><th>Evidence</th></tr></thead>
              <tbody>
                {usb4MeasuredRows.map(([label, value, unit]) => (
                  <tr>
                    <td>{label}</td>
                    <td class="mono">{value}</td>
                    <td>{unit}</td>
                    <td>
                      {usb4EvidenceUrl
                        ? <a href={usb4EvidenceUrl} target="_blank" rel="noreferrer">source ↗</a>
                        : usb4Telemetry.source_url || 'source unavailable'}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
        <p style="font-size: 0.76rem; color: #64748b; margin: 0.9rem 0 0;">
          Link observations: ghost {usb4Telemetry.ghost_link || 'unavailable'}{usb4ObservedAt ? ` (${usb4ObservedAt})` : ''} ·
          exo-0 {usb4Telemetry.exo0_link || 'unavailable'}.
          {usb4Telemetry.derivation ? ` ${usb4Telemetry.derivation}` : ''}
        </p>
      </article>
    </div>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--  DENSE RECENT RUNS & OPEN BUGS LISTS                         -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <div class="lists-split">
      <!-- Recent Runs Changelog -->
      <section class="dense-panel">
        <h2>Recent Runs & Builds</h2>
        <div class="dense-list">
          {runs.slice(0, 12).map((run) => (
            <div class="dense-row">
              <div style="display: flex; align-items: center; gap: 10px;">
                <span class={`pill pill--${run.overall === 'passed' ? 'completed' : run.overall === 'running' ? 'pending' : 'failed'}`} style="padding: 0.2rem 0.5rem; font-size: 0.72rem;">
                  {run.overall}
                </span>
                <span style="font-weight: 600;">{run.label || run.id}</span>
              </div>
              <div class="mono" style="text-align: right;">
                <div>{run.started_at ? formatUtc(run.started_at) : '—'}</div>
                <div style="font-size: 0.75rem; color: #64748b;">
                  Duration: {run.duration_min !== null ? `${run.duration_min}m` : '—'} · Trigger: {run.trigger || 'manual'}
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Open Bugs -->
      <section class="dense-panel">
        <h2>Open Bugs ({openBugs.length})</h2>
        <div class="dense-list">
          {openBugs.map((bug) => (
            <div class="dense-row" style="flex-direction: column; align-items: start; gap: 6px;">
              <a href={bug.url} target="_blank" rel="noreferrer">
                #{bug.number}: {bug.title}
              </a>
              <div class="bug-meta">
                Created: {formatUtc(bug.created_at)}
              </div>
            </div>
          ))}
          {openBugs.length === 0 && (
            <div style="color: #64748b; font-size: 0.88rem; padding: 10px;">
              No open bugs found in telemetry dataset!
            </div>
          )}
        </div>
      </section>
    </div>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--  DATA INTEGRITY DISCLOSURE                                   -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <p style="font-size: 0.85rem; color: #64748b; margin-top: 2rem;">
      Data source: <a href={`${baseUrl}data/factory-stats.json`} style="color: #38bdf8; text-decoration: none;">factory-stats.json</a>
      {stats?._meta?.generated && <span> · updated {formatUtc(stats._meta.generated)}</span>}
    </p>
  </div>
  <script is:inline src="https://cdn.jsdelivr.net/npm/echarts@5/dist/echarts.min.js" defer data-cfasync="false"></script>
  <script id="factory-build-health-payload" type="application/json" set:html={serializedBuildHealthData}></script>
  <script id="triage-spark-payload" type="application/json" set:html={serializedTriageSparkData}></script>
  <script id="bst-cache-chart-payload" type="application/json" set:html={serializedBstChartData}></script>
  <script id="usb4-execution-payload" type="application/json" set:html={serializedUsb4ExecutionData}></script>
  <script is:inline data-cfasync="false">
    (function() {
      const charts = [];

      function bootFactoryBuildHealth(echarts) {
        const payloadNode = document.getElementById('factory-build-health-payload');
        const chartEl = document.getElementById('factory-build-outcomes-chart');
        if (!payloadNode || !chartEl) return;
        const data = JSON.parse(payloadNode.textContent || '{}');
        if (!Array.isArray(data.outcomes) || !data.outcomes.length) return;
        const chart = echarts.init(chartEl);
        charts.push(chart);
        chart.setOption({
          animation: false,
          grid: { left: 38, right: 12, top: 18, bottom: 24 },
          legend: { top: 0, textStyle: { color: '#94a3b8', fontSize: 10 } },
          tooltip: {
            trigger: 'axis',
            axisPointer: { type: 'shadow' },
            backgroundColor: 'rgba(15, 23, 42, 0.95)',
            borderColor: 'rgba(255, 255, 255, 0.1)',
            textStyle: { color: '#cbd5e1', fontSize: 11 }
          },
          xAxis: {
            type: 'category',
            data: data.outcomes.map(function(day) { return day.date.slice(5); }),
            axisLabel: { color: '#64748b', fontSize: 9 },
            axisTick: { show: false },
            axisLine: { lineStyle: { color: 'rgba(255,255,255,0.08)' } }
          },
          yAxis: {
            type: 'value',
            minInterval: 1,
            axisLabel: { color: '#64748b', fontSize: 9 },
            splitLine: { lineStyle: { color: 'rgba(255,255,255,0.04)' } }
          },
          series: [
            { name: 'Passed', type: 'bar', stack: 'outcomes', data: data.outcomes.map(function(day) { return day.passed; }), itemStyle: { color: '#4ade80' } },
            { name: 'Failed', type: 'bar', stack: 'outcomes', data: data.outcomes.map(function(day) { return day.failed; }), itemStyle: { color: '#f43f5e' } }
          ]
        });
      }

      function bootTriageSparks(echarts) {
        const payloadNode = document.getElementById('triage-spark-payload');
        if (!payloadNode) return;
        const data = JSON.parse(payloadNode.textContent || '{}');
        if (!data.lanes) return;
        data.lanes.forEach(function(lane) {
          const elements = document.querySelectorAll('.triage-spark[data-lane="' + lane.key + '"]');
          elements.forEach(function(el) {
            if (!el || !lane.points || !lane.points.length) return;
            const chart = echarts.init(el);
            charts.push(chart);
            chart.setOption({
              animation: false,
              grid: { left: 34, right: 6, top: 8, bottom: 16 },
              tooltip: {
                trigger: 'axis',
                backgroundColor: 'rgba(15, 23, 42, 0.95)',
                borderColor: 'rgba(255, 255, 255, 0.1)',
                textStyle: { color: '#cbd5e1', fontSize: 11 },
                formatter: function(params) {
                  const p = lane.points[params[0].dataIndex];
                  return (p.t || '') + '<br/>' +
                    (p.duration !== null ? p.duration + ' min' : 'duration unavailable') +
                    ' · ' + (p.passed ? 'passed' : 'failed');
                }
              },
              xAxis: {
                type: 'category',
                data: lane.points.map(function(p) { return (p.t || '').slice(5, 10); }),
                axisLabel: { color: '#64748b', fontSize: 8, interval: Math.max(1, Math.floor(lane.points.length / 5)) },
                axisTick: { show: false },
                axisLine: { lineStyle: { color: 'rgba(255,255,255,0.08)' } }
              },
              yAxis: {
                type: 'value',
                axisLabel: { color: '#64748b', fontSize: 8, formatter: '{value}m' },
                splitLine: { lineStyle: { color: 'rgba(255,255,255,0.04)' } }
              },
              series: [{
                type: 'line',
                data: lane.points.map(function(p) { return p.duration; }),
                smooth: true,
                showSymbol: true,
                symbolSize: 5,
                lineStyle: { color: '#38bdf8', width: 1.5 },
                itemStyle: {
                  color: function(params) {
                    return lane.points[params.dataIndex].passed ? '#4ade80' : '#f43f5e';
                  }
                },
                areaStyle: { color: 'rgba(56, 189, 248, 0.08)' }
              }]
            });
          });
        });
      }

      function bootBstCacheChart(echarts) {
        const payloadNode = document.getElementById('bst-cache-chart-payload');
        if (!payloadNode) return;
        const data = JSON.parse(payloadNode.textContent || '{}');
        const chartEl = document.getElementById('bst-cache-chart');
        if (!chartEl || !data.cells) return;

        const heatData = [];
        data.drives.forEach(function(drive, driveIdx) {
          data.caches.forEach(function(cacheLabel, cacheIdx) {
            const cell = (data.cells[driveIdx] && data.cells[driveIdx][cacheIdx]) || {
              state: 'unavailable',
              state_reason: 'cache cell missing from published dataset',
              percent: null
            };
            heatData.push([driveIdx, cacheIdx, cell.state === 'available' && Number.isFinite(cell.percent) ? cell.percent : -1, cell]);
          });
        });

        const chart = echarts.init(chartEl);
        charts.push(chart);
        chart.setOption({
          tooltip: {
            backgroundColor: 'rgba(15, 23, 42, 0.95)',
            borderColor: 'rgba(255, 255, 255, 0.1)',
            textStyle: { color: '#cbd5e1' },
            formatter: function(params) {
              const cell = params.data && params.data[3] ? params.data[3] : {};
              const drive = data.drives[params.data ? params.data[0] : 0] || 'unknown drive';
              const cache = data.caches[params.data ? params.data[1] : 0] || 'unknown cache';
              if (cell.state !== 'available') {
                return cache + ' on ' + drive + '<br/>unavailable: ' + (cell.state_reason || 'state_reason unavailable');
              }
              const usedMb = cell.used_bytes != null ? (cell.used_bytes / (1024 * 1024)).toFixed(2) : '?';
              const capMb = cell.capacity_bytes != null ? (cell.capacity_bytes / (1024 * 1024)).toFixed(0) : '?';
              return cache + ' on ' + drive + '<br/>' + cell.percent + '% used (' + usedMb + ' MB / ' + capMb + ' MB)';
            }
          },
          grid: { left: 90, right: 20, top: 20, bottom: 30 },
          xAxis: {
            type: 'category',
            data: data.drives,
            splitArea: { show: true },
            axisLabel: { color: '#94a3b8', fontSize: 10, fontWeight: 'bold' }
          },
          yAxis: {
            type: 'category',
            data: data.caches,
            splitArea: { show: true },
            axisLabel: { color: '#94a3b8', fontSize: 10 }
          },
          visualMap: {
            min: 0,
            max: 100,
            show: true,
            orient: 'horizontal',
            left: 'center',
            bottom: -5,
            textStyle: { color: '#94a3b8', fontSize: 9 },
            text: ['100%', '0%'],
            inRange: { color: ['#1e293b', '#38bdf8', '#eab308', '#f97316', '#f43f5e'] },
            outOfRange: { color: '#475569' }
          },
          series: [{
            name: 'Cache utilization',
            type: 'heatmap',
            data: heatData,
            label: {
              show: true,
              color: '#f1f5f9',
              fontSize: 10,
              fontWeight: 'bold',
              formatter: function(params) {
                const cell = params.data && params.data[3] ? params.data[3] : {};
                return cell.state === 'available' && Number.isFinite(cell.percent) ? cell.percent + '%' : 'N/A';
              }
            },
            itemStyle: {
              borderColor: 'rgba(15, 23, 42, 0.8)',
              borderWidth: 2
            }
          }]
        });
      }

      function bootBstCacheTrend(echarts) {
        const payloadNode = document.getElementById('bst-cache-chart-payload');
        const chartEl = document.getElementById('bst-cache-trend-chart');
        if (!payloadNode || !chartEl) return;
        const data = JSON.parse(payloadNode.textContent || '{}');
        const snapshots = Array.isArray(data.trend) ? data.trend : [];
        if (!snapshots.length) return;
        const pointsById = new Map();
        const detailsByPoint = new Map();
        snapshots.forEach(function(snapshot) {
          const timestamp = snapshot.recorded_at || snapshot.collected_at || snapshot.timestamp || snapshot.t;
          const key = [snapshot.cache_backend, snapshot.pod, snapshot.storage_type].filter(Boolean).join(':');
          if (!key || !timestamp) return;
          if (!pointsById.has(key)) pointsById.set(key, []);
          pointsById.get(key).push({
              t: timestamp,
              requests: Number.isFinite(snapshot.requests) ? snapshot.requests : null,
              hitCount: snapshot.hit_count,
              missCount: snapshot.miss_count,
              bytes: snapshot.bytes,
              latencyMs: snapshot.latency_ms,
              effectiveness: snapshot.effectiveness,
              logicalFillPercent: snapshot.logical_fill_percent,
              logicalFillBytes: snapshot.logical_fill_bytes,
              logicalCapacityBytes: snapshot.logical_capacity_bytes,
              state: snapshot.state || 'unavailable',
              reason: snapshot.state_reason || 'state_reason unavailable'
          });
          detailsByPoint.set(key + '|' + timestamp, snapshot);
        });
        const series = Array.from(pointsById.entries()).map(function(entry) {
          const points = entry[1];
          return {
            name: entry[0],
            type: 'line',
            connectNulls: false,
            smooth: true,
            showSymbol: false,
            data: points.map(function(point) { return [point.t, point.requests]; })
          };
        }).filter(function(item) { return item.data.some(function(point) { return point[1] !== null; }); });
        if (!series.length) {
          const empty = document.getElementById('bst-cache-trend-unavailable');
          if (empty) {
            empty.textContent = 'Cache heat trend unavailable: published snapshots contain no readable request counts.';
            empty.style.display = '';
          }

          function bootUsb4ExecutionHeatmap(echarts) {
            const payloadNode = document.getElementById('usb4-execution-payload');
            const chartEl = document.getElementById('usb4-execution-heatmap');
            const unavailable = document.getElementById('usb4-execution-heatmap-unavailable');
            if (!payloadNode || !chartEl) return;
            const data = JSON.parse(payloadNode.textContent || '{}');
            const rows = Array.isArray(data.rows) ? data.rows : [];
            const nodes = Array.isArray(data.nodes) && data.nodes.length ? data.nodes : ['ghost', 'exo-0'];
            const measured = rows.filter(function(row) { return row.state === 'available'; });
            if (unavailable) unavailable.style.display = measured.length ? 'none' : '';
            const timestamps = Array.from(new Set(rows.map(function(row) { return row.timestamp; }).filter(Boolean))).sort();
            if (!timestamps.length) timestamps.push(data.windowStart || 'UTC window');
            const points = [];
            const sourceRows = rows.length ? rows : nodes.map(function(node) {
              return { node: node, timestamp: timestamps[0], state: 'unavailable', state_reason: 'No measured workflow telemetry row was published.' };
            });
            sourceRows.forEach(function(row) {
              const x = timestamps.indexOf(row.timestamp);
              const y = nodes.indexOf(row.node);
              const value = Number.isFinite(row.throughput) ? row.throughput : -1;
              if (x >= 0 && y >= 0) points.push([x, y, value, row]);
            });
            const chart = echarts.init(chartEl);
            charts.push(chart);
            chart.setOption({
              animation: false,
              tooltip: {
                position: 'top',
                backgroundColor: 'rgba(15, 23, 42, 0.95)',
                borderColor: 'rgba(255, 255, 255, 0.1)',
                textStyle: { color: '#cbd5e1', fontSize: 11 },
                formatter: function(params) {
                  const row = params.data && params.data[3] ? params.data[3] : {};
                  const throughput = row.throughput == null ? 'unavailable' : row.throughput + ' bytes/s';
                  const latency = row.latency_ms == null ? 'unavailable' : row.latency_ms + ' ms';
                  const action = row.action_count == null ? 'unavailable' : row.action_count;
                  const cache = row.cache_result || 'unavailable';
                  const temperature = row.temperature || 'unavailable';
                  return row.node + ' · ' + (row.timestamp || 'UTC timestamp unavailable') +
                    '<br/>throughput: ' + throughput +
                    '<br/>latency: ' + latency +
                    '<br/>actions: ' + action +
                    '<br/>cache: ' + cache + ' · ' + temperature +
                    (row.state !== 'available' ? '<br/>unavailable: ' + (row.state_reason || 'state_reason unavailable') : '');
                }
              },
              grid: { left: 72, right: 20, top: 18, bottom: 42 },
              xAxis: { type: 'category', data: timestamps, axisLabel: { color: '#94a3b8', fontSize: 9 } },
              yAxis: { type: 'category', data: nodes, axisLabel: { color: '#94a3b8', fontSize: 10 } },
              visualMap: {
                min: 0, max: Math.max(1, ...points.filter(function(point) { return point[2] >= 0; }).map(function(point) { return point[2]; })),
                orient: 'horizontal', left: 'center', bottom: 0,
                textStyle: { color: '#94a3b8', fontSize: 9 },
                inRange: { color: ['#0f172a', '#0ea5e9', '#4ade80', '#f59e0b'] },
                outOfRange: { color: '#475569' }
              },
              series: [{ type: 'heatmap', data: points, label: { show: false }, itemStyle: { borderColor: 'rgba(15, 23, 42, 0.8)', borderWidth: 2 } }]
            });
          }
          chartEl.style.display = 'none';
          return;
        }
        const chart = echarts.init(chartEl);
        charts.push(chart);
        chart.setOption({
          animation: false,
          grid: { left: 48, right: 18, top: 24, bottom: 34 },
          legend: { type: 'scroll', textStyle: { color: '#94a3b8', fontSize: 10 } },
          tooltip: {
            trigger: 'axis',
            backgroundColor: 'rgba(15, 23, 42, 0.95)',
            borderColor: 'rgba(255, 255, 255, 0.1)',
            textStyle: { color: '#cbd5e1', fontSize: 11 },
            formatter: function(params) {
              return params.map(function(param) {
                const value = param.value[1];
                const detail = detailsByPoint.get(param.seriesName + '|' + param.value[0]) || {};
                const status = value == null
                  ? '<br/>unavailable: ' + (detail.state_reason || 'state_reason unavailable')
                  : '<br/>hits: ' + (detail.hit_count == null ? 'unavailable' : detail.hit_count) +
                    ' · misses: ' + (detail.miss_count == null ? 'unavailable' : detail.miss_count) +
                    ' · bytes: ' + (detail.bytes == null ? 'unavailable' : detail.bytes) +
                    ' · latency: ' + (detail.latency_ms == null ? 'unavailable' : detail.latency_ms + ' ms') +
                    ' · logical fill: ' + (detail.logical_fill_percent == null
                      ? 'unavailable'
                      : detail.logical_fill_percent + '%');
                return param.seriesName + ': ' + (value == null ? 'unavailable' : value + ' GET requests') + status;
              }).join('<br/>') + '<br/><span style="color:#94a3b8">' + params[0].axisValue + '</span>';
            }
          },
          xAxis: { type: 'time', axisLabel: { color: '#64748b', fontSize: 9 }, axisLine: { lineStyle: { color: 'rgba(255,255,255,0.08)' } } },
          yAxis: { type: 'value', min: 0, name: 'GET requests', nameTextStyle: { color: '#94a3b8', fontSize: 10 }, axisLabel: { color: '#64748b' }, splitLine: { lineStyle: { color: 'rgba(255,255,255,0.04)' } } },
          series: series
        });
      }

      function waitForCharts(attempt) {
        if (attempt === undefined) attempt = 0;
        if (window.echarts) {
          bootFactoryBuildHealth(window.echarts);
          bootTriageSparks(window.echarts);
          bootBstCacheChart(window.echarts);
          bootBstCacheTrend(window.echarts);
          bootUsb4ExecutionHeatmap(window.echarts);
          return;
        }
        if (attempt > 40) return;
        window.setTimeout(function() { waitForCharts(attempt + 1); }, 125);
      }

      window.addEventListener('resize', function() {
        charts.forEach(function(chart) { chart.resize(); });
      });

      waitForCharts();
    })();
  </script>
</SiteLayout>
