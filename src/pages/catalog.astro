---
import SiteLayout from '../layouts/SiteLayout.astro';
import { loadCatalogPageModel } from '../lib/catalog-page';
import { serializeJsonScript } from '../lib/json-script';

const baseUrl = import.meta.env.BASE_URL;
const pageModel = loadCatalogPageModel(process.cwd());

const {
  apps,
  providers,
  installed,
  summary,
  state,
  state_reason
} = pageModel;

const categories = Array.from(new Set(apps.flatMap((app) =>
  (app.category || 'Uncategorized')
    .split(/[,;]/)
    .map((c) => c.trim())
    .filter(Boolean)
))).sort();

const providerNames = providers.map((p) => p.provider).sort();

const formatUtc = (value: string | null) =>
  value
    ? new Date(value).toLocaleString('en-US', {
        dateStyle: 'medium',
        timeStyle: 'short',
        timeZone: 'UTC',
        hour12: false
      }) + ' UTC'
    : 'Never';

const installCommand = (appName: string) =>
  `argo submit --from workflowtemplate/catalog-install-lsio -p app=${appName} -p mode=gitops -n argo --watch`;

const serializePayload = serializeJsonScript({ apps, categories, providerNames, summary });
---

<SiteLayout
  title="App Catalog"
  description="Browse, search, and install catalog applications on the lab cluster."
  current="catalog"
>
  <style>
    .dashboard-header {
      margin-bottom: 2rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      padding-bottom: 1.5rem;
    }
    .dashboard-header h1 {
      font-size: 2.25rem;
      font-weight: 800;
      letter-spacing: -0.04em;
      margin: 0 0 0.5rem 0;
      background: linear-gradient(135deg, #f8fafc 30%, #94a3b8 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .meta-bar {
      font-size: 0.85rem;
      color: #94a3b8;
      display: flex;
      gap: 1.5rem;
      flex-wrap: wrap;
      align-items: center;
    }
    .meta-bar a { color: #38bdf8; text-decoration: none; }
    .meta-bar a:hover { text-decoration: underline; }

    .kpi-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      gap: 1rem;
      margin-bottom: 1.5rem;
    }
    .kpi-card {
      background: linear-gradient(180deg, rgba(30, 41, 59, 0.4) 0%, rgba(15, 23, 42, 0.6) 100%);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 16px;
      padding: 1.25rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      min-height: 110px;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .kpi-card:hover {
      border-color: rgba(56, 189, 248, 0.3);
      transform: translateY(-3px);
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
    }
    .kpi-card__title {
      font-size: 0.78rem;
      font-weight: 700;
      color: #94a3b8;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .kpi-card__value {
      font-size: 1.8rem;
      font-weight: 800;
      color: #f8fafc;
      letter-spacing: -0.04em;
      margin: 0.5rem 0 0.2rem 0;
    }
    .kpi-card__sub {
      font-size: 0.72rem;
      color: #64748b;
    }

    .filter-bar {
      background: rgba(15, 23, 42, 0.45);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 16px;
      padding: 1rem 1.25rem;
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      align-items: center;
      margin-bottom: 1.5rem;
    }
    .filter-bar input,
    .filter-bar select {
      background: rgba(30, 41, 59, 0.6);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 10px;
      padding: 0.55rem 0.75rem;
      color: #e2e8f0;
      font-size: 0.9rem;
      min-width: 200px;
    }
    .filter-bar select option { background: #0f172a; color: #e2e8f0; }
    .filter-bar input::placeholder { color: #64748b; }
    .filter-bar label {
      font-size: 0.75rem;
      font-weight: 700;
      color: #94a3b8;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .filter-group { display: flex; flex-direction: column; gap: 0.35rem; }
    .filter-results {
      margin-left: auto;
      font-size: 0.8rem;
      color: #94a3b8;
    }

    .catalog-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 1.25rem;
      margin-bottom: 2.5rem;
    }
    .app-card {
      background: linear-gradient(180deg, rgba(30, 41, 59, 0.35) 0%, rgba(15, 23, 42, 0.55) 100%);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 20px;
      padding: 1.25rem;
      display: flex;
      flex-direction: column;
      gap: 0.9rem;
      transition: all 0.3s ease;
    }
    .app-card:hover {
      border-color: rgba(56, 189, 248, 0.25);
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
    }
    .app-card.is-installed {
      border-color: rgba(16, 185, 129, 0.25);
      background: linear-gradient(180deg, rgba(16, 185, 129, 0.06) 0%, rgba(15, 23, 42, 0.55) 100%);
    }
    .app-card__header {
      display: flex;
      gap: 0.9rem;
      align-items: flex-start;
    }
    .app-logo {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      object-fit: contain;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.06);
      flex-shrink: 0;
    }
    .app-logo.is-missing {
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.25rem;
      color: #64748b;
    }
    .app-title-wrap { flex: 1; min-width: 0; }
    .app-title {
      font-size: 1.15rem;
      font-weight: 800;
      color: #f1f5f9;
      margin: 0;
      line-height: 1.2;
    }
    .app-badges {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin-top: 0.35rem;
    }
    .badge {
      font-size: 0.68rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      padding: 0.2rem 0.5rem;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      color: #cbd5e1;
      background: rgba(30, 41, 59, 0.6);
    }
    .badge--provider { color: #a78bfa; border-color: rgba(167, 139, 250, 0.25); background: rgba(167, 139, 250, 0.08); }
    .badge--installed { color: #34d399; border-color: rgba(16, 185, 129, 0.25); background: rgba(16, 185, 129, 0.08); }
    .badge--category { color: #7dd3fc; border-color: rgba(125, 211, 252, 0.2); background: rgba(125, 211, 252, 0.06); }

    .app-description {
      font-size: 0.85rem;
      color: #94a3b8;
      line-height: 1.5;
      margin: 0;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .app-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      font-size: 0.75rem;
      color: #64748b;
    }
    .app-meta span { display: flex; align-items: center; gap: 0.25rem; }

    .app-actions {
      margin-top: auto;
      display: flex;
      gap: 0.6rem;
      flex-wrap: wrap;
    }
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      font-size: 0.8rem;
      font-weight: 700;
      padding: 0.55rem 0.85rem;
      border-radius: 10px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      background: rgba(30, 41, 59, 0.6);
      color: #e2e8f0;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.2s ease;
    }
    .btn:hover { background: rgba(56, 189, 248, 0.12); border-color: rgba(56, 189, 248, 0.3); }
    .btn--primary { background: rgba(56, 189, 248, 0.12); border-color: rgba(56, 189, 248, 0.25); color: #7dd3fc; }
    .btn--primary:hover { background: rgba(56, 189, 248, 0.2); }
    .btn--installed { background: rgba(16, 185, 129, 0.1); border-color: rgba(16, 185, 129, 0.2); color: #34d399; cursor: default; }

    .install-panel {
      display: none;
      margin-top: 0.75rem;
      padding: 0.85rem;
      background: rgba(6, 9, 20, 0.5);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 12px;
    }
    .install-panel.is-open { display: block; }
    .install-panel code {
      display: block;
      font-size: 0.75rem;
      padding: 0.65rem 0.75rem;
      background: rgba(30, 41, 59, 0.6);
      border-radius: 8px;
      overflow-x: auto;
      white-space: nowrap;
      color: #e2e8f0;
      margin-bottom: 0.6rem;
    }
    .install-panel p {
      font-size: 0.75rem;
      color: #94a3b8;
      margin: 0 0 0.5rem 0;
    }
    .install-panel a { color: #38bdf8; }

    .unavailable-panel {
      background: rgba(15, 23, 42, 0.45);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 20px;
      padding: 2rem;
      text-align: center;
      color: #94a3b8;
    }
    .unavailable-panel h2 {
      color: #f1f5f9;
      margin: 0 0 0.5rem 0;
      font-size: 1.25rem;
    }
    .unavailable-panel p { max-width: 600px; margin: 0 auto 1rem auto; line-height: 1.5; }

    .integrity-panel { margin-top: 2.5rem; }

    @media (max-width: 640px) {
      .filter-bar { flex-direction: column; align-items: stretch; }
      .filter-bar input, .filter-bar select { min-width: unset; width: 100%; }
      .filter-results { margin-left: 0; }
      .catalog-grid { grid-template-columns: 1fr; }
    }
  </style>

  <div id="catalog-page">
    <div class="dashboard-header">
      <h1>App Catalog</h1>
      <div class="meta-bar">
        <span>Browse provider catalogs and install apps via GitOps.</span>
        <a href={`${baseUrl}reference/WORKFLOWS.html#catalog-install-lsio`}>Install workflow docs</a>
        <a href="https://github.com/projectbluefin/lab/tree/main/docs/data/catalog">Raw catalog data ↗</a>
      </div>
    </div>

    <div class="kpi-grid">
      <article class="kpi-card">
        <p class="kpi-card__title">Providers</p>
        <p class="kpi-card__value">{summary.provider_count}</p>
        <p class="kpi-card__sub">{providerNames.join(', ') || 'None'}</p>
      </article>
      <article class="kpi-card">
        <p class="kpi-card__title">Apps</p>
        <p class="kpi-card__value">{summary.app_count}</p>
        <p class="kpi-card__sub">across {summary.category_count} categories</p>
      </article>
      <article class="kpi-card">
        <p class="kpi-card__title">Installed</p>
        <p class="kpi-card__value">{summary.installed_count}</p>
        <p class="kpi-card__sub">on the lab cluster</p>
      </article>
      <article class="kpi-card">
        <p class="kpi-card__title">Generated</p>
        <p class="kpi-card__value" style="font-size: 1rem; line-height: 1.3; margin-top: 0.65rem;">{formatUtc(summary.generated_at)}</p>
        <p class="kpi-card__sub">latest provider index</p>
      </article>
    </div>

    {state === 'unavailable' ? (
      <div class="unavailable-panel">
        <h2>Catalog unavailable</h2>
        <p>{state_reason}</p>
        <p>Provider indexes belong in <code>docs/data/catalog/&lt;provider&gt;.json</code> matching the schema in <code>docs/reference/catalog-index-schema.md</code>.</p>
      </div>
    ) : (
      <>
        <div class="filter-bar" role="search" aria-label="Catalog filters">
          <div class="filter-group">
            <label for="catalog-search">Search</label>
            <input id="catalog-search" type="search" placeholder="Filter by name or description" autocomplete="off" />
          </div>
          <div class="filter-group">
            <label for="catalog-category">Category</label>
            <select id="catalog-category">
              <option value="">All categories</option>
              {categories.map((c) => <option value={c}>{c}</option>)}
            </select>
          </div>
          <div class="filter-group">
            <label for="catalog-provider">Provider</label>
            <select id="catalog-provider">
              <option value="">All providers</option>
              {providerNames.map((p) => <option value={p}>{p}</option>)}
            </select>
          </div>
          <div class="filter-group">
            <label for="catalog-installed">Status</label>
            <select id="catalog-installed">
              <option value="">All apps</option>
              <option value="installed">Installed only</option>
              <option value="not-installed">Not installed</option>
            </select>
          </div>
          <span class="filter-results" id="catalog-result-count">{apps.length} apps</span>
        </div>

        <div class="catalog-grid" id="catalog-grid">
          {apps.map((app) => (
            <article
              class:list={['app-card', app.installed && 'is-installed']}
              data-name={app.name.toLowerCase()}
              data-description={(app.description || '').toLowerCase()}
              data-categories={(app.category || 'Uncategorized')
                .split(/[,;]/)
                .map((c) => c.trim().toLowerCase())
                .join(',')}
              data-provider={app.provider}
              data-installed={String(app.installed)}
            >
              <div class="app-card__header">
                {app.logo_url ? (
                  <img src={app.logo_url} alt="" class="app-logo" loading="lazy" width="48" height="48" />
                ) : (
                  <span class="app-logo is-missing" aria-hidden="true">📦</span>
                )}
                <div class="app-title-wrap">
                  <h2 class="app-title">{app.name}</h2>
                  <div class="app-badges">
                    <span class:list={['badge', 'badge--provider']}>{app.provider}</span>
                    {app.category && <span class="badge badge--category">{app.category}</span>}
                    {app.installed && <span class="badge badge--installed">Installed</span>}
                  </div>
                </div>
              </div>

              <p class="app-description">{app.description || 'No description available.'}</p>

              <div class="app-meta">
                {app.monthly_pulls != null && (
                  <span title="Monthly pulls">⬇️ {app.monthly_pulls.toLocaleString()} pulls/mo</span>
                )}
                {app.stars != null && <span>⭐ {app.stars.toLocaleString()}</span>}
                {app.architectures && app.architectures.length > 0 && (
                  <span>🖥️ {app.architectures.join(', ')}</span>
                )}
              </div>

              <div class="app-actions">
                {app.installed ? (
                  <span class="btn btn--installed">✓ Installed</span>
                ) : (
                  <button type="button" class="btn btn--primary catalog-install-toggle" data-app={app.name}>Install</button>
                )}
                {app.config_pointer && (
                  <a class="btn" href={app.config_pointer} target="_blank" rel="noopener noreferrer">Upstream docs ↗</a>
                )}
              </div>

              {!app.installed && (
                <div class="install-panel" id={`install-panel-${app.name}`}>
                  <p>Run this from a machine with Argo CLI access:</p>
                  <code>{installCommand(app.name)}</code>
                  <p>
                    Default mode is <strong>gitops</strong>: the workflow renders manifests, validates them, commits to a branch, and opens a PR.
                    See <a href={`${baseUrl}reference/WORKFLOWS.html#catalog-install-lsio`}>catalog-install-lsio docs</a> for parameters.
                  </p>
                </div>
              )}
            </article>
          ))}
        </div>
      </>
    )}

    <div class="integrity-panel">
      <div class="stat-dl" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; padding: 1rem; background: rgba(15, 23, 42, 0.4); border: 1px solid rgba(255, 255, 255, 0.06); border-radius: 16px;">
        <div class="stat-dl-item" style="display: flex; justify-content: space-between; align-items: center;">
          <dt style="font-size: 0.75rem; color: #94a3b8; font-weight: 700; text-transform: uppercase;">Generated at</dt>
          <dd style="font-size: 0.85rem; color: #e2e8f0; margin: 0;">{formatUtc(summary.generated_at)}</dd>
        </div>
        <div class="stat-dl-item" style="display: flex; justify-content: space-between; align-items: center;">
          <dt style="font-size: 0.75rem; color: #94a3b8; font-weight: 700; text-transform: uppercase;">Status</dt>
          <dd style="font-size: 0.85rem; color: #fbbf24; margin: 0;">{summary.status}</dd>
        </div>
        <div class="stat-dl-item" style="display: flex; justify-content: space-between; align-items: center;">
          <dt style="font-size: 0.75rem; color: #94a3b8; font-weight: 700; text-transform: uppercase;">Installed list</dt>
          <dd style="font-size: 0.85rem; margin: 0;">
            <a href="https://github.com/projectbluefin/lab/blob/main/docs/data/catalog/installed.json" target="_blank" rel="noopener noreferrer" style="color: #38bdf8;">installed.json ↗</a>
          </dd>
        </div>
      </div>
    </div>
  </div>

  <script type="application/json" id="catalog-page-data" set:html={serializePayload} />

  <script data-cfasync="false">
    const payload = JSON.parse(document.getElementById('catalog-page-data').textContent);
    const searchInput = document.getElementById('catalog-search');
    const categorySelect = document.getElementById('catalog-category');
    const providerSelect = document.getElementById('catalog-provider');
    const installedSelect = document.getElementById('catalog-installed');
    const grid = document.getElementById('catalog-grid');
    const resultCount = document.getElementById('catalog-result-count');
    const cards = Array.from(document.querySelectorAll('.app-card'));

    function matches(card) {
      const term = (searchInput?.value || '').toLowerCase().trim();
      const category = categorySelect?.value || '';
      const provider = providerSelect?.value || '';
      const installed = installedSelect?.value || '';

      if (term) {
        const name = card.dataset.name || '';
        const description = card.dataset.description || '';
        if (!name.includes(term) && !description.includes(term)) return false;
      }
      if (category) {
        const categories = (card.dataset.categories || '').split(',');
        if (!categories.includes(category.toLowerCase())) return false;
      }
      if (provider && card.dataset.provider !== provider) return false;
      if (installed) {
        const isInstalled = card.dataset.installed === 'true';
        if (installed === 'installed' && !isInstalled) return false;
        if (installed === 'not-installed' && isInstalled) return false;
      }
      return true;
    }

    function update() {
      let visible = 0;
      for (const card of cards) {
        const show = matches(card);
        card.style.display = show ? '' : 'none';
        if (show) visible++;
      }
      if (resultCount) resultCount.textContent = `${visible} app${visible === 1 ? '' : 's'}`;
    }

    searchInput?.addEventListener('input', update);
    categorySelect?.addEventListener('change', update);
    providerSelect?.addEventListener('change', update);
    installedSelect?.addEventListener('change', update);

    document.addEventListener('click', (event) => {
      const toggle = event.target.closest('.catalog-install-toggle');
      if (!toggle) return;
      const appName = toggle.dataset.app;
      const panel = document.getElementById(`install-panel-${appName}`);
      if (!panel) return;
      const isOpen = panel.classList.contains('is-open');
      panel.classList.toggle('is-open', !isOpen);
      toggle.textContent = isOpen ? 'Install' : 'Hide install steps';
      event.preventDefault();
    });
  </script>
</SiteLayout>
