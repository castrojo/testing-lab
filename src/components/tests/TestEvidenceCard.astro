---
interface ArtifactEvidence {
  state: string;
  state_reason: string | null;
}

interface RunHistoryPoint {
  workflow_uid: string | null;
  workflow_name: string | null;
  state: string;
  phase: string | null;
  started_at: string | null;
  finished_at: string | null;
  observed_at: string | null;
  image_ref: string | null;
  digest: string | null;
  source_url: string | null;
}

interface MatrixRow {
  id: string;
  variant: string;
  branch: string;
  suite: string;
  role: string;
  result_status: string;
  last_run: string | null;
  scenarios_total: number | null;
  scenarios_failed: number | null;
  pass_rate: number | null;
  state: string;
  state_reason: string | null;
  enrollment_issue_url: string | null;
  flake_flips: number;
  runs_recorded: number;
  evidence_state: string;
  evidence_state_reason: string | null;
  started_at: string | null;
  finished_at: string | null;
  observed_at: string | null;
  workflow_uid: string | null;
  image_ref: string | null;
  digest: string | null;
  image_state: string;
  results_evidence: ArtifactEvidence | null;
  screenshot_evidence: ArtifactEvidence | null;
  terminal_failure_streak: number | null;
  repeated_failed_scenarios: Array<{ scenario: string; failed_runs: number }>;
  repeated_failed_scenarios_state: string;
  repeated_failed_scenarios_reason: string | null;
  run_history: RunHistoryPoint[];
  evidence_source: string;
  results_path: string | null;
  screenshot_url: string | null;
  source_url: string;
  collected_at: string;
}

interface Props {
  row: MatrixRow;
  resultsHref: string | null;
}

const { row, resultsHref } = Astro.props;

const formatUtc = (value: string | null) =>
  value
    ? new Date(value).toLocaleString('en-US', {
        dateStyle: 'medium',
        timeStyle: 'short',
        timeZone: 'UTC',
      }) + ' UTC'
    : 'Unavailable';

const selectedTimestamp = row.finished_at ?? row.observed_at ?? row.last_run;
const selectedState = row.evidence_source === 'qa-run-v1' ? row.evidence_state : row.result_status;
const isNotEnrolled = Boolean(row.enrollment_issue_url);
const resultsState = row.results_evidence?.state ?? (resultsHref ? 'available' : 'unavailable');
const screenshotState = row.screenshot_evidence?.state ?? (row.screenshot_url ? 'available' : 'unavailable');
const shortDigest = row.digest ? `${row.digest.slice(0, 19)}…` : 'Unavailable';

const statusLabel = (state: string) => {
  if (state === 'failed' && row.role === 'gate') return 'Terminal failed gate';
  if (state === 'running') return 'Running';
  if (state === 'stale') return 'Stale evidence';
  if (state === 'unavailable') return isNotEnrolled ? 'Not enrolled' : 'Unavailable';
  return state;
};
---

<details id={row.id} class="detail-card evidence-card">
  <summary>
    <div>
      <p class="detail-card__eyebrow">{row.variant} / {row.branch} / {row.suite}</p>
      <h3>{row.id}</h3>
      <p class="evidence-card__summary">
        Selected run: {formatUtc(selectedTimestamp)} · {row.evidence_source === 'qa-run-v1' ? 'immutable qa-run-v1' : 'legacy compatibility projection'}
      </p>
    </div>
    <div class="detail-card__summary">
      <span class:list={['pill', `pill--${selectedState}`]}>{statusLabel(selectedState)}</span>
      <span class="evidence-card__role">{row.role === 'gate' ? 'GATE' : 'INFO'}</span>
    </div>
  </summary>

  <div class="detail-card__body">
    <div class="evidence-card__grid">
      <section>
        <h4>Selected run</h4>
        <dl>
          <div><dt>Lane</dt><dd>{row.variant} / {row.branch}</dd></div>
          <div><dt>Suite</dt><dd>{row.suite} · {row.role}</dd></div>
          <div><dt>Observed</dt><dd>{formatUtc(row.observed_at)}</dd></div>
          <div><dt>Started</dt><dd>{formatUtc(row.started_at)}</dd></div>
          <div><dt>Finished</dt><dd>{formatUtc(row.finished_at)}</dd></div>
          <div><dt>Image digest</dt><dd><code title={row.digest ?? undefined}>{shortDigest}</code></dd></div>
          <div><dt>Workflow ID</dt><dd><code>{row.workflow_uid ?? 'Unavailable'}</code></dd></div>
        </dl>
      </section>

      <section>
        <h4>Evidence</h4>
        <div class="evidence-card__links">
          <a href={row.source_url} target="_blank" rel="noreferrer">
            <strong>Published source</strong>
            <span>Public immutable provenance</span>
          </a>
          {resultsHref ? (
            <a href={resultsHref}>
              <strong>Result artifact</strong>
              <span>{row.results_path}</span>
            </a>
          ) : (
            <div class="evidence-card__placeholder">
              <strong>Result artifact · {resultsState}</strong>
              <span>{row.results_evidence?.state_reason ?? 'No public static result artifact is published.'}</span>
            </div>
          )}
          {row.screenshot_url ? (
            <a href={row.screenshot_url} target="_blank" rel="noreferrer">
              <strong>Screenshot artifact</strong>
              <span>Public static image</span>
            </a>
          ) : (
            <div class="evidence-card__placeholder">
              <strong>Screenshot artifact · {screenshotState}</strong>
              <span>{row.screenshot_evidence?.state_reason ?? 'No public static screenshot is published.'}</span>
            </div>
          )}
        </div>
      </section>
    </div>

    {row.evidence_state_reason && (
      <p class="evidence-card__reason">{row.evidence_state_reason}</p>
    )}

    {row.terminal_failure_streak && row.terminal_failure_streak > 0 && (
      <p class="evidence-card__signal">
        Terminal failure streak: <strong>{row.terminal_failure_streak}</strong>
      </p>
    )}

    {row.repeated_failed_scenarios.length > 0 && (
      <p class="evidence-card__signal">
        Repeated failures:
        {row.repeated_failed_scenarios.map((scenario) => (
          <span class="evidence-card__scenario">{scenario.scenario} ({scenario.failed_runs} runs)</span>
        ))}
      </p>
    )}

    <section class="evidence-card__history">
      <h4>Timestamped history</h4>
      {row.run_history.length > 0 ? (
        <ol>
          {[...row.run_history].reverse().map((run) => (
            <li>
              <span class:list={['pill', `pill--${run.state}`]}>{run.state}</span>
              <span>{formatUtc(run.finished_at ?? run.observed_at)}</span>
              <code>{run.workflow_uid ?? 'Workflow ID unavailable'}</code>
              {run.source_url && <a href={run.source_url} target="_blank" rel="noreferrer">source</a>}
            </li>
          ))}
        </ol>
      ) : (
        <p class="evidence-card__empty">
          {row.evidence_source === 'legacy-results-v1'
            ? 'History is unavailable: this row is a legacy compatibility projection.'
            : 'No immutable QA-run history has been published.'}
        </p>
      )}
    </section>
  </div>
</details>

<style>
  .evidence-card {
    scroll-margin-top: 1rem;
  }
  .evidence-card:target {
    border-color: rgba(56, 189, 248, 0.65);
    box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.12);
  }
  .evidence-card__summary,
  .evidence-card__reason,
  .evidence-card__signal,
  .evidence-card__empty {
    margin: 0;
    color: #94a3b8;
    font-size: 0.82rem;
  }
  .evidence-card__role {
    color: #fda4af;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }
  .evidence-card__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .evidence-card h4 {
    margin: 0 0 0.75rem;
  }
  .evidence-card dl {
    gap: 0;
  }
  .evidence-card dl div {
    align-items: baseline;
    border-bottom: 1px dashed rgba(148, 163, 184, 0.16);
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    padding: 0.4rem 0;
  }
  .evidence-card dt {
    color: #94a3b8;
    font-size: 0.78rem;
  }
  .evidence-card dd {
    margin: 0;
    overflow-wrap: anywhere;
    text-align: right;
  }
  .evidence-card code {
    color: #cbd5e1;
    font-size: 0.74rem;
  }
  .evidence-card__links {
    display: grid;
    gap: 0.6rem;
  }
  .evidence-card__links > * {
    border: 1px solid rgba(148, 163, 184, 0.18);
    border-radius: 10px;
    display: grid;
    gap: 0.2rem;
    padding: 0.75rem;
  }
  .evidence-card__links a {
    color: #7dd3fc;
    text-decoration: none;
  }
  .evidence-card__links a:hover {
    border-color: rgba(125, 211, 252, 0.5);
  }
  .evidence-card__links span {
    color: #94a3b8;
    font-size: 0.75rem;
    overflow-wrap: anywhere;
  }
  .evidence-card__placeholder {
    background: rgba(71, 85, 105, 0.16);
    color: #cbd5e1;
  }
  .evidence-card__reason,
  .evidence-card__signal {
    border-left: 2px solid #fbbf24;
    margin-top: 1rem;
    padding-left: 0.75rem;
  }
  .evidence-card__scenario {
    background: rgba(244, 63, 94, 0.12);
    border: 1px solid rgba(244, 63, 94, 0.24);
    border-radius: 999px;
    color: #fda4af;
    display: inline-block;
    font-size: 0.74rem;
    margin-left: 0.5rem;
    padding: 0.1rem 0.45rem;
  }
  .evidence-card__history {
    border-top: 1px solid rgba(148, 163, 184, 0.14);
    margin-top: 1rem;
    padding-top: 1rem;
  }
  .evidence-card__history ol {
    display: grid;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .evidence-card__history li {
    align-items: center;
    border-bottom: 1px solid rgba(148, 163, 184, 0.1);
    display: grid;
    gap: 0.6rem;
    grid-template-columns: max-content minmax(11rem, 1fr) minmax(0, 1.5fr) max-content;
    padding: 0.45rem 0;
  }
  .evidence-card__history a {
    color: #7dd3fc;
    font-size: 0.78rem;
  }
  @media (max-width: 760px) {
    .evidence-card__grid {
      grid-template-columns: 1fr;
    }
    .evidence-card__history li {
      align-items: start;
      grid-template-columns: max-content 1fr;
    }
    .evidence-card__history li code,
    .evidence-card__history li a {
      grid-column: 2;
    }
  }
</style>
