---
interface MatrixCell {
  id: string;
  variant: string;
  branch: string;
  suite: string;
  role: string;
  result_status: string;
  pass_rate: number | null;
  state: string;
  state_reason: string | null;
  enrollment_issue_url: string | null;
  evidence_state: string;
  evidence_state_reason: string | null;
  terminal_failure_streak: number | null;
  flake_flips: number;
}

interface MatrixRow {
  variant: string;
  branch: string;
  cells: (MatrixCell | null)[];
}

interface Props {
  matrix: MatrixRow[];
  suiteOrder: string[];
  suiteRoles: Record<string, string>;
}

const { matrix, suiteOrder, suiteRoles } = Astro.props;

const statusFor = (cell: MatrixCell) =>
  cell.evidence_state === 'unavailable' && cell.state === 'available'
    ? cell.result_status
    : cell.evidence_state;

const labelFor = (cell: MatrixCell) => {
  if (cell.enrollment_issue_url) return 'not enrolled';
  if (cell.evidence_state === 'failed' && cell.role === 'gate') return 'terminal failed gate';
  if (cell.evidence_state === 'stale') return 'stale';
  if (cell.evidence_state === 'running') return 'running';
  if (cell.flake_flips > 0) return 'flake signal';
  return statusFor(cell);
};
---

<div class="suite-matrix__legend" aria-label="Matrix legend">
  <span><b>Gate</b> affects a release verdict</span>
  <span><b>Info</b> is visible without gating</span>
  <span>Each row is a branch-safe lane</span>
</div>

<div class="table-scroll">
  <table class="matrix-table suite-matrix">
    <thead>
      <tr>
        <th scope="col">Lane</th>
        {suiteOrder.map((suite) => (
          <th scope="col">
            <span>{suite}</span>
            <small>{suiteRoles[suite] === 'gate' ? 'GATE' : 'INFO'}</small>
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      {matrix.map(({ variant, branch, cells }) => (
        <tr>
          <th scope="row">
            <span class="suite-matrix__variant">{variant}</span>
            <span class="suite-matrix__branch">{branch}</span>
          </th>
          {cells.map((cell) => (
            <td class:list={['matrix-table__cell', cell ? `suite-matrix__cell--${statusFor(cell)}` : 'is-missing']}>
              {cell ? (
                <a href={`#${cell.id}`} class="matrix-table__link">
                  <span class:list={['pill', `pill--${statusFor(cell)}`]}>{labelFor(cell)}</span>
                  <strong>{cell.pass_rate === null ? '—' : `${cell.pass_rate}%`}</strong>
                  {cell.pass_rate !== null && (
                    <span class="progress-bar-container" aria-label={`${cell.pass_rate}% pass rate`}>
                      <span
                        class:list={[
                          'progress-bar',
                          cell.pass_rate >= 90
                            ? 'progress-bar--passed'
                            : cell.pass_rate >= 60
                              ? 'progress-bar--warning'
                              : 'progress-bar--failed',
                        ]}
                        style={`width: ${cell.pass_rate}%`}
                      />
                    </span>
                  )}
                  {cell.terminal_failure_streak && cell.terminal_failure_streak > 1 && (
                    <span class="suite-matrix__signal">{cell.terminal_failure_streak}-run streak</span>
                  )}
                  {cell.enrollment_issue_url ? (
                    <span class="suite-matrix__reason">Tracking issue</span>
                  ) : (
                    <span class="suite-matrix__reason">{cell.evidence_state_reason ?? cell.state_reason ?? 'Open evidence'}</span>
                  )}
                </a>
              ) : (
                <span class="matrix-table__empty">No published row</span>
              )}
            </td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .suite-matrix__legend {
    color: #94a3b8;
    display: flex;
    flex-wrap: wrap;
    font-size: 0.78rem;
    gap: 0.6rem 1rem;
    margin-bottom: 1rem;
  }
  .suite-matrix__legend b { color: #cbd5e1; }
  .suite-matrix small {
    color: #94a3b8;
    display: block;
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    margin-top: 0.25rem;
  }
  .suite-matrix__variant,
  .suite-matrix__branch {
    display: block;
  }
  .suite-matrix__variant { color: #f8fafc; }
  .suite-matrix__branch {
    color: #7dd3fc;
    font-size: 0.72rem;
    font-weight: 600;
    margin-top: 0.2rem;
  }
  .suite-matrix__cell--failed { background: rgba(244, 63, 94, 0.11); }
  .suite-matrix__cell--stale { background: rgba(245, 158, 11, 0.1); }
  .suite-matrix__cell--running { background: rgba(56, 189, 248, 0.1); }
  .suite-matrix__cell--passed { background: rgba(16, 185, 129, 0.08); }
  .suite-matrix__reason {
    color: #94a3b8;
    font-size: 0.73rem;
    line-height: 1.25;
  }
  .suite-matrix__signal {
    color: #fda4af;
    font-size: 0.72rem;
    font-weight: 700;
  }
  .progress-bar-container {
    background: rgba(148, 163, 184, 0.18);
    border-radius: 999px;
    display: block;
    height: 0.3rem;
    overflow: hidden;
    width: 100%;
  }
  .progress-bar {
    display: block;
    height: 100%;
  }
  .progress-bar--passed { background: #34d399; }
  .progress-bar--warning { background: #fbbf24; }
  .progress-bar--failed { background: #fb7185; }
</style>
